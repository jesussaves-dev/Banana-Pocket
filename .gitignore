/output/
/.buildroot/
/ui/banana-ui
/ui/banana-scrape
/ui/tests/out/
/system/bananad/bananad
/app/bananatube/banana-tube
*.o
/banana-*.bundle

# a game's card image, and game dumps: never committed — every player brings
# their own, and the recompiled code that comes from them is theirs too
/qemu-out/
*.zcci
*.cci
*.cia
*.3ds

# Python bytecode
__pycache__/
*.pyc

# a player's own background-music loop dropped in the tree to copy to the card (never committed, like a game dump)
/bgm.wav

# the deploy key baked into the image for network installs (never commit it)
/system/rootfs/etc/banana/ssh/authorized_keys

# fetched icon references (tools/fetch-ref.py): local artifacts, not shipped
/tmp/
/ui/assets/refs/

# icon source art and scratch previews: local working files, the shipped 32x32 icons are in the tree
/Fantasy Icons/
/test icons/
/tmp_new_style_preview.png
/tmp_pixellab_preview.png
/ui/assets/overrides/palette_master.png
