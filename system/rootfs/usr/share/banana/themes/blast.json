{
  // Banana Blast: the Genesis style. A neon course at night, every system a billboard beside it and the banana on a
  // skateboard between them, on the 310-wide canvas the handheld's 1240 px panel draws at 4 device px per unit. The art
  // is baked by tools/gen-blast.py to the Mega Drive's rules: 9-bit colour, true black for every backdrop (the AMOLED's
  // pixels stay off), no blends. The billboards, names and counts are live, so a new system needs no new art.
  "name": "Banana Blast",
  "author": "Banana Pocket",
  "style": "genesis",
  "base": "dark",
  "accent": "#ff00b6",
  "font": "banana-blast",
  "crisp": true,
  "canvas": { "w": 310 },

  // the cues, a boost for L/R and the loop, synthesised by tools/gen-blast-sounds.py (2-op FM, the PSG, crushed voice)
  "sounds": { "scroll": "blast/sounds/scroll.wav", "select": "blast/sounds/select.wav", "back": "blast/sounds/back.wav",
    "fav": "blast/sounds/fav.wav", "ready": "blast/sounds/ready.wav", "insert": "blast/sounds/insert.wav",
    "boost": "blast/sounds/boost.wav", "bgm": "blast/sounds/bgm.wav",
    // the secret's: the Blue Banana's boost, the code's fanfare, and the Sound Test's numbers past the cues
    "rev": "blast/sounds/rev.wav", "secret": "blast/sounds/secret.wav",
    "num0": "blast/sounds/num0.wav", "num1": "blast/sounds/num1.wav", "num2": "blast/sounds/num2.wav", "num3": "blast/sounds/num3.wav", "num4": "blast/sounds/num4.wav", "num5": "blast/sounds/num5.wav", "num6": "blast/sounds/num6.wav", "num7": "blast/sounds/num7.wav",
    "num8": "blast/sounds/num8.wav", "num9": "blast/sounds/num9.wav", "num10": "blast/sounds/num10.wav", "num11": "blast/sounds/num11.wav", "num12": "blast/sounds/num12.wav", "num13": "blast/sounds/num13.wav", "num14": "blast/sounds/num14.wav", "num15": "blast/sounds/num15.wav" },

  // every colour is on the Mega Drive's grid: a channel is one of 00 24 49 6d 92 b6 db ff
  "vars": {
    "art": "blast/night",
    "void": "#000000", "ink": "#ffffff", "dim": "#929292", "line": "#494949",
    "label": "#ffdb00", "mag": "#ff00b6", "cyan": "#00dbff", "blue": "#2449ff",
    "chrome0": "#ffffff", "chrome1": "#b6ffff", "chrome2": "#00dbff", "chrome3": "#2449db",
    "chrome4": "#ff6d00", "chrome5": "#ffb600", "chrome6": "#ffff49",
    "hi": "=mag"
  },

  // left and right ride one billboard, L and R boost to the next maker's
  "input": {
    "home": { "l": "prevBlock", "r": "nextBlock" },
    "library": { "up": "prev", "down": "next", "left": "prev:7", "right": "next:7" }
  },
  "behavior": { "launchMs": 700, "scrollMs": 110, "fps": 4 },

  "components": {
    // chrome title type: one stop per row of the 24-unit line, white over a cyan/blue horizon line, then orange into
    // yellow, outlined in black. Capitals sit on rows 4-17.
    "chrome": {
      "type": "text", "font": "banana-blast-title", "size": 24, "color": "=chrome0",
      "gradient": { "hard": true, "stops": [
        "=chrome0", "=chrome0", "=chrome0", "=chrome0", "=chrome0", "=chrome0", "=chrome0", "=chrome0",
        "=chrome1", "=chrome2", "=chrome2", "=chrome3", "=chrome4", "=chrome4", "=chrome5", "=chrome5",
        "=chrome6", "=chrome6", "=chrome6", "=chrome6", "=chrome6", "=chrome6", "=chrome6", "=chrome6" ] },
      "outline": { "width": 1, "color": "=void" }
    },
    // a button and what it does: the key in yellow on a black chip, the label in white
    "pill": {
      "type": "group", "layout": "row", "gap": 3, "align": "center", "h": 13,
      "children": [
        { "type": "group", "layout": "row", "padding": 2, "h": 13, "align": "center", "fill": "=void", "border": 1, "borderColor": "=line",
          "children": [ { "type": "text", "size": 12, "text": "{item.key}", "color": "=label" } ] },
        { "type": "text", "size": 12, "text": "{item.label}", "color": "=ink", "outline": { "width": 1, "color": "=void" } }
      ]
    },
    // a parallax layer: 640 wide, repeating every 320, moving `speed` units per system
    "layer": {
      "type": "image", "src": "{art}/{name}.png", "fit": "pixel",
      "x": "=-mod(round(scroll * speed), 320)", "y": 0, "w": 640, "h": 150
    }
  },

  "screens": {
    "all": { "top": [
      // the era's HUD: yellow labels, white values, outlined in black
      { "type": "text", "size": 12, "x": 8, "y": 6, "text": "Time", "upper": true, "color": "=label", "outline": { "width": 1, "color": "=void" } },
      { "type": "text", "size": 12, "x": 40, "y": 6, "text": "{clock}", "color": "=ink", "outline": { "width": 1, "color": "=void" } },
      { "type": "text", "size": 12, "right": 34, "y": 6, "w": 30, "align": "right", "text": "Batt", "upper": true, "color": "=label",
        "outline": { "width": 1, "color": "=void" }, "visible": "=battery >= 0" },
      { "type": "text", "size": 12, "right": 6, "y": 6, "w": 26, "align": "right", "text": "{battery}%",
        "color": "=battery < 20 && !charging ? '#ff2400' : charging ? cyan : ink", "outline": { "width": 1, "color": "=void" },
        "visible": "=battery >= 0" },
      // starting a game: the palette fades a 9-bit level at a time while the lines wobble (Motion off: the fade
      // alone), and back from a sleep the levels step up again
      { "type": "effect",
        "wobble": "=view == 'launch' && motion ? launch.progress * 9 : 0", "wobblePhase": "=launch.t * 0.021",
        "fade": "=view == 'launch' ? ceil(launch.progress * 7) : wake.progress < 1 ? 7 - floor(wake.progress * 7) : 0" }
    ] },

    "home": {
      "top": [
        // the black sky with its raster bar at the horizon, then three layers at three speeds
        { "type": "image", "src": "{art}/sky.png", "fit": "pixel", "x": 0, "y": 0, "w": 310, "h": 151 },
        { "type": "image", "src": "{art}/stars.png", "fit": "pixel",
          "x": "=-mod(round(scroll * 6), 320)", "y": 0, "w": 640, "h": 150 },
        // the twinkling stars, one pixel each, so a twinkle at rest redraws 20 dots and not the sky
        // (positions from `tools/gen-blast.py --twinkle`)
        { "type": "list", "source": "range", "count": 20, "range": 20, "x": 0, "y": 0, "w": 310, "h": 150, "scrollMode": "none",
          "selectedOnTop": false,
          "item": { "type": "rect", "w": 1, "h": 1,
            "x": "=mod(pick(i, 162, 27, 300, 202, 175, 91, 177, 308, 281, 142, 24, 298, 278, 252, 125, 137, 264, 307, 76, 248) - round(scroll * 6), 320)",
            "y": "=pick(i, 110, 94, 76, 61, 108, 69, 55, 57, 27, 31, 116, 49, 78, 24, 117, 79, 97, 112, 96, 82)",
            "fill": "=mod(i + (motion ? floor(time / 500) : 0), 2) == 0 ? '#242449' : '#ffffff'" } },
        { "use": "layer", "with": { "name": "shapes", "speed": 19 } },
        { "use": "layer", "with": { "name": "city", "speed": 45 } },

        // the cross lines, rolling toward you while the course moves (travel grows with every system passed, so a
        // boost rolls them fast): line i is 40 * (i + 1) units away less the distance rolled, and lands on row
        // 1600 / z under the horizon, Night Drive's magenta at level 2 far out to 7 close (9-bit, as gen-blast's S()).
        // Drawn first, so the rails cross over them. Motion off: they hold still.
        { "type": "list", "source": "range", "count": 10, "range": 10, "x": 0, "y": 0, "w": 310, "h": 270, "scrollMode": "none",
          "selectedOnTop": false,
          "item": { "type": "rect", "x": 0, "w": 310, "h": 1,
            "y": "=150 + ceil(1600 / (40 * (i + 1) - mod(motion ? travel * 40 : 0, 40)))",
            "visible": "=1600 / (40 * (i + 1) - mod(motion ? travel * 40 : 0, 40)) >= 4 && 1600 / (40 * (i + 1) - mod(motion ? travel * 40 : 0, 40)) <= 119",
            "fill": "=rgb(round(min(7, 2 + floor(ceil(1600 / (40 * (i + 1) - mod(motion ? travel * 40 : 0, 40))) / 16)) * 255 / 7), 0, round(round(5 * min(7, 2 + floor(ceil(1600 / (40 * (i + 1) - mod(motion ? travel * 40 : 0, 40))) / 16)) / 7) * 255 / 7))" } },

        // the floor: one scanline a row, each scrolled by its own depth (the Mega Drive's per-line scroll), so the
        // rails converge on the horizon and slide past at the right speed on every line
        { "type": "list", "source": "range", "count": 119, "direction": "column", "x": 0, "y": 151, "w": 310, "h": 119,
          "itemH": 1, "scrollMode": "none", "selectedOnTop": false,
          "item": { "type": "image", "src": "{art}/floor/row{i}.png", "fit": "pixel", "y": 0, "h": 1,
            "x": "=-round(mod(scroll * 130, 32) * (i + 1) / 26)", "w": "=310 + floor(32 * (i + 1) / 26) + 2" } },

        // the billboards: one a system, 130 units apart along the course, framed in its maker's colour
        { "type": "list", "source": "systems", "direction": "free", "x": 0, "y": 0, "w": 310, "h": 150, "range": 2,
          "item": {
            "type": "group", "x": "=105 + round(pos * 130)", "y": 74, "w": 100, "h": 76,
            "children": [
              { "type": "rect", "x": 18, "y": 48, "w": 2, "h": 28, "fill": "#6d6d6d" },
              { "type": "rect", "x": 80, "y": 48, "w": 2, "h": 28, "fill": "#6d6d6d" },
              { "type": "rect", "x": 0, "y": 0, "w": 100, "h": 48, "fill": "=void", "border": 2,
                "borderColor": "=sel ? pick(mod(floor(time / 250), 4), mag, '#9200ff', blue, cyan) : pick(item.maker == 'Nintendo' ? 0 : item.maker == 'Sega' ? 1 : item.maker == 'Sony' ? 2 : item.maker == 'NEC' ? 3 : item.maker == 'SNK' ? 4 : item.maker == 'Atari' ? 5 : 6, '#920024', '#004992', '#006d92', '#924900', '#926d00', '#92006d', '#499200')" },
              { "type": "rect", "x": 4, "y": 4, "w": 92, "h": 1, "visible": "=sel",
                "fill": "=pick(item.maker == 'Nintendo' ? 0 : item.maker == 'Sega' ? 1 : item.maker == 'Sony' ? 2 : item.maker == 'NEC' ? 3 : item.maker == 'SNK' ? 4 : item.maker == 'Atari' ? 5 : 6, '#ff0024', '#006dff', '#00dbff', '#ff6d00', '#ffdb00', '#ff00b6', '#6dff00')" },
              { "type": "text", "size": 12, "x": 4, "w": 92, "y": 8, "h": 26, "align": "center", "valign": "middle", "wrap": true, "maxLines": 2,
                "lineHeight": 11, "text": "{upper(item.name)}",
                "color": "=pick(item.maker == 'Nintendo' ? 0 : item.maker == 'Sega' ? 1 : item.maker == 'Sony' ? 2 : item.maker == 'NEC' ? 3 : item.maker == 'SNK' ? 4 : item.maker == 'Atari' ? 5 : 6, '#ff0024', '#006dff', '#00dbff', '#ff6d00', '#ffdb00', '#ff00b6', '#6dff00')" },
              { "type": "text", "size": 12, "x": 4, "w": 92, "y": 34, "align": "center",
                "text": "=item.games == 0 ? 'NO GAMES' : item.games == 1 ? '1 GAME' : item.games + ' GAMES'", "color": "=sel ? ink : dim" },
              { "type": "image", "src": "{art}/fav.png", "fit": "pixel", "x": 6, "y": 6, "w": 8, "h": 8, "visible": "=item.fav" },
              // the selected one has an arrow over it, blinking yellow and white
              { "type": "group", "x": 47, "y": "=-10 + mod(floor(time / 250), 2)", "w": 7, "h": 4, "visible": "=sel",
                "children": [
                  { "type": "rect", "x": 0, "y": 0, "w": 7, "h": 1, "fill": "=mod(floor(time / 500), 2) ? ink : label" },
                  { "type": "rect", "x": 1, "y": 1, "w": 5, "h": 1, "fill": "=mod(floor(time / 500), 2) ? ink : label" },
                  { "type": "rect", "x": 2, "y": 2, "w": 3, "h": 1, "fill": "=mod(floor(time / 500), 2) ? ink : label" },
                  { "type": "rect", "x": 3, "y": 3, "w": 1, "h": 1, "fill": "=mod(floor(time / 500), 2) ? ink : label" }
                ] }
            ]
          } },

        // a boost: speed lines while the course runs more than a system's length
        { "type": "image", "src": "{art}/speed{mod(floor(abs(scroll) * 6), 2)}.png", "fit": "pixel", "x": 0, "y": 36, "w": 310, "h": 186,
          "visible": "=motion && abs(scroll - cursor) > 1.2" },

        // the Blue Banana (the Sound Test's secret) leaves two afterimages behind it while boosting
        { "type": "image", "src": "{art}/ghost-far.png", "fit": "pixel", "x": "=139 - dir * 14", "y": 201, "w": 32, "h": 22,
          "visible": "=blueBanana && motion && abs(scroll - cursor) > 1.2" },
        { "type": "image", "src": "{art}/ghost-near.png", "fit": "pixel", "x": "=139 - dir * 7", "y": 201, "w": 32, "h": 22,
          "visible": "=blueBanana && motion && abs(scroll - cursor) > 1.2" },

        // the banana: on the board, wheels turning while it rolls; left alone for 20 s it steps off and taps a foot
        { "type": "image", "fit": "pixel", "x": 139, "y": 201, "w": 32, "h": 22,
          "src": "{art}/{blueBanana ? 'blue-' : ''}{moved > 20000 && entered > 20000 && abs(scroll - cursor) < 0.02 ? 'idle' + mod(floor(time / 500), 2) : 'ride' + (abs(scroll - cursor) > 0.02 ? mod(floor(abs(scroll) * 8), 2) : 0)}.png" },

        // what's selected: its name in chrome, its maker under it, then the buttons
        { "use": "chrome", "x": 0, "y": 224, "w": 310, "align": "center", "text": "{upper(sys.name)}" },
        { "type": "text", "size": 12, "x": 0, "y": 243, "w": 310, "align": "center",
          "text": "=upper(sys.maker) + '  ' + (cursor + 1) + '/' + count", "color": "=dim",
          "outline": { "width": 1, "color": "=void" } },
        { "type": "list", "source": "hints", "direction": "row", "x": 8, "y": 255, "w": 294, "h": 13, "gap": 6, "flow": true, "scrollMode": "none",
          "justify": "between", "item": { "use": "pill" } }
      ]
    },

    "library": {
      "top": [
        // the cart rack: black under a dim red grid (level 2: no near-black fills), the system's name in chrome over a
        // rule in its maker's colour (the billboard's), the carts down the left and the box art on the right
        { "type": "rect", "x": 0, "y": 0, "w": 310, "h": 270, "fill": "=void" },
        { "type": "list", "source": "range", "count": 15, "range": 15, "x": 0, "y": 46, "w": 310, "h": 224, "scrollMode": "none",
          "selectedOnTop": false, "item": { "type": "rect", "x": "=i * 22", "y": 0, "w": 1, "h": 224, "fill": "#490000" } },
        { "type": "list", "source": "range", "count": 10, "range": 10, "x": 0, "y": 46, "w": 310, "h": 224, "scrollMode": "none",
          "selectedOnTop": false, "item": { "type": "rect", "x": 0, "y": "=22 + i * 22", "w": 310, "h": 1, "fill": "#490000" } },
        { "use": "chrome", "x": 8, "y": 20, "w": 200, "text": "{upper(sys.name)}" },
        { "type": "text", "size": 12, "right": 8, "y": 26, "w": 80, "align": "right", "text": "{cursor + 1}/{count}", "color": "=dim", "visible": "=!empty" },
        { "type": "rect", "x": 0, "y": 44, "w": 310, "h": 2,
          "fill": "=pick(sys.maker == 'Nintendo' ? 0 : sys.maker == 'Sega' ? 1 : sys.maker == 'Sony' ? 2 : sys.maker == 'NEC' ? 3 : sys.maker == 'SNK' ? 4 : sys.maker == 'Atari' ? 5 : 6, '#ff0024', '#006dff', '#00dbff', '#ff6d00', '#ffdb00', '#ff00b6', '#6dff00')" },

        { "type": "image", "src": "{game.art}", "fallback": "{sys.icon}", "x": 182, "y": 54, "w": 120, "h": 120,
          "fit": "=boxLook == 'original' ? 'contain' : 'dither9Contain'" },
        { "type": "text", "size": 12, "x": 182, "y": 180, "w": 120, "text": "{game.sub}", "color": "=dim", "wrap": true, "maxLines": 5 },
        { "type": "text", "size": 12, "x": 8, "w": 166, "y": 100, "align": "center", "text": "{upper(empty.title)}", "color": "=label",
          "visible": "=empty", "wrap": true },
        { "type": "text", "size": 12, "x": 8, "w": 166, "y": 130, "align": "center", "text": "{empty.hint}", "color": "=dim",
          "visible": "=empty", "wrap": true },

        { "type": "list", "source": "games", "direction": "column", "x": 8, "y": 52, "w": 166, "h": 198, "itemH": 22, "gap": 0,
          "scrollMode": "edge", "clip": true,
          "item": { "type": "group", "w": 166, "h": 22, "children": [
            { "type": "rect", "x": "=sel ? 6 : 0", "y": 1, "w": 158, "h": 20, "fill": "=void", "border": 1, "borderColor": "=sel ? dim : line" },
            { "type": "rect", "x": "=sel ? 10 : 4", "y": 4, "w": 128, "h": 14, "fill": "=sel ? cyan : void" },
            { "type": "rect", "x": "=sel ? 144 : 138", "y": 5, "w": 1, "h": 12, "fill": "=line" },
            { "type": "rect", "x": "=sel ? 148 : 142", "y": 5, "w": 1, "h": 12, "fill": "=line" },
            { "type": "rect", "x": "=sel ? 152 : 146", "y": 5, "w": 1, "h": 12, "fill": "=line" },
            { "type": "text", "size": 12, "x": "=sel ? 13 : 7", "y": 5, "w": 124, "text": "{upper(item.title)}", "color": "=sel ? void : dim" },
            { "type": "image", "src": "{art}/fav.png", "fit": "pixel", "right": 4, "y": 7, "w": 8, "h": 8, "visible": "=item.fav" }
          ] } },

        { "type": "list", "source": "hints", "direction": "row", "x": 8, "y": 255, "w": 294, "h": 13, "gap": 6, "flow": true, "scrollMode": "none",
          "justify": "between", "item": { "use": "pill" } }
      ]
    },

    // X on a game: its page. The cart rack's black, the name in yellow, the facts under it, then the achievements.
    // Left/Right the neighbouring game, Up/Down the achievements, B back to the rack.
    "game": {
      "top": [
        { "type": "rect", "x": 0, "y": 0, "w": 310, "h": 270, "fill": "=void" },
        { "use": "chrome", "x": 8, "y": 20, "w": 296, "text": "{upper(sys.name)}" },
        { "type": "rect", "x": 0, "y": 44, "w": 310, "h": 2,
          "fill": "=pick(sys.maker == 'Nintendo' ? 0 : sys.maker == 'Sega' ? 1 : sys.maker == 'Sony' ? 2 : sys.maker == 'NEC' ? 3 : sys.maker == 'SNK' ? 4 : sys.maker == 'Atari' ? 5 : 6, '#ff0024', '#006dff', '#00dbff', '#ff6d00', '#ffdb00', '#ff00b6', '#6dff00')" },
        { "type": "image", "src": "{game.art}", "fallback": "{sys.icon}", "x": 8, "y": 54, "w": 92, "h": 100,
          "fit": "=boxLook == 'original' ? 'contain' : 'dither9Contain'" },
        { "type": "text", "size": 12, "x": 108, "y": 54, "w": 194, "text": "{upper(game.title)}", "color": "=label", "wrap": true, "maxLines": 2,
          "outline": { "width": 1, "color": "=void" } },
        { "type": "text", "size": 12, "x": 108, "y": 80, "w": 194, "text": "{game.sub}", "color": "=dim" },
        { "type": "text", "size": 12, "x": 108, "y": 94, "w": 194, "text": "{page.developer}", "color": "=ink", "visible": "=page.developer != ''" },
        { "type": "text", "size": 12, "x": 108, "y": 108, "w": 194, "text": "{page.publisher}", "color": "=ink", "visible": "=page.publisher != ''" },
        { "type": "text", "size": 12, "x": 108, "y": 122, "w": 194, "text": "{page.players}P", "color": "=ink", "visible": "=page.players != ''" },
        { "type": "text", "size": 12, "x": 108, "y": 136, "w": 194, "text": "{game.plays} plays  {game.time}", "color": "=cyan" },
        { "type": "text", "size": 12, "x": 108, "y": 148, "w": 194, "text": "Last {game.last}", "color": "=dim", "visible": "=game.plays != '0'" },
        { "type": "image", "src": "{art}/fav.png", "fit": "pixel", "right": 8, "y": 54, "w": 8, "h": 8, "visible": "=game.fav" },

        { "type": "text", "size": 12, "x": 8, "y": 160, "w": 294, "text": "{page.desc}", "color": "=dim", "wrap": true, "maxLines": 2,
          "visible": "=page.desc != ''" },

        { "type": "text", "size": 12, "x": 8, "y": 188, "w": 294, "text": "{page.achWon} / {page.achCount} achievements", "upper": true, "color": "=label",
          "visible": "=page.achCount > 0" },
        { "type": "text", "size": 12, "x": 8, "y": 188, "w": 294, "text": "No achievements yet", "upper": true, "color": "=dim", "visible": "=page.achCount == 0" },
        { "type": "list", "source": "achievements", "direction": "column", "x": 8, "y": 201, "w": 294, "h": 52, "itemH": 13, "gap": 0,
          "scrollMode": "edge", "clip": true,
          "item": { "type": "group", "w": 294, "h": 13, "children": [
            { "type": "image", "src": "{item.badge}", "fit": "contain", "x": 0, "y": 1, "w": 11, "h": 11, "visible": "=item.badge != ''" },
            { "type": "text", "size": 12, "x": 15, "y": 0, "w": 244, "text": "{item.title}", "color": "=item.won ? ink : dim" },
            { "type": "text", "size": 12, "right": 0, "y": 0, "w": 30, "align": "right", "text": "{item.points}", "color": "=sel ? cyan : dim" }
          ] } },

        { "type": "list", "source": "hints", "direction": "row", "x": 8, "y": 255, "w": 294, "h": 13, "gap": 6, "flow": true, "scrollMode": "none",
          "justify": "between", "item": { "use": "pill" } }
      ]
    }
  }
}
