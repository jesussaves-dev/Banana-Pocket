{
  // Sundown Strip: generated by tools/gen-street.py from street.json (edit that one, then run it again).
  // Banana Street: every system a shop on one street, on a 310-wide canvas that the handheld's 1240 px panel draws at
  // exactly 4 device px per unit. The art is baked by tools/gen-street.py to the Super NES's rules (15-bit colour,
  // shading ramps, scanline skies) for each time of day: "phase" (dawn, day, dusk, night) picks the folder. The system
  // icons, names and counts stay live, so a new system needs no new art. Text is Banana's own pixel faces at 12 / 24.
  "name": "Sundown Strip",
  "author": "BananaOS",
  "style": "snes",
  "base": "dark",
  "accent": "#ff9c5a",
  "font": "banana",
  "crisp": true,
  "canvas": { "w": 310 },
  // Settings in this style: the workshop's panels (tools/gen-street.py)
  "workshop": "street/sundown",

  "vars": {
    "art": "street/sundown",
    "ink": "#191010", "dk": "#5a293a", "paper": "#ffe6ce", "paperLo": "#deb59c",
    "awnA": "#ffce52", "awnB": "#3a8c94", "awnC": "#bd4a7b",
    "gold": "#ff9c5a", "goldLo": "#c56329", "hudLo": "#100808",
    "goldTop": "#ffe6d6", "goldHi": "#ffc59c", "goldDeep": "#7b3a21",
    "hi": "=gold"
  },

  // the street: left and right walk one shop, L and R jump to the next maker's block;
  // the library is one shelf, left and right a page of it
  "input": {
    "home": { "l": "prevBlock", "r": "nextBlock" },
    "library": { "up": "prev", "down": "next", "left": "prev:5", "right": "next:5" }
  },
  "behavior": { "launchMs": 700, "scrollMs": 110, "fps": 4, "cues": { "insert": 450 } },

  "components": {
    // a button and what it does: the key on a paper chip
    "pill": {
      "type": "group", "layout": "row", "gap": 3, "align": "center", "h": 13,
      "children": [
        { "type": "group", "layout": "row", "padding": 2, "h": 13, "align": "center", "fill": "=paper", "border": 1, "borderColor": "=ink",
          "children": [ { "type": "text", "size": 12, "text": "{item.key}", "color": "=ink" } ] },
        { "type": "text", "size": 12, "text": "{item.label}", "color": "=paper", "shadow": { "x": 1, "y": 1, "color": "=hudLo" } }
      ]
    },
    // a cobbled band of the road, faster toward the viewer: `with` gives its band, top, height, cobble width, the
    // picture's width and the speed (units moved per shop)
    "band": {
      "type": "image", "src": "{art}/dusk/band{n}.png", "fit": "pixel",
      "x": "=-mod(round(scroll * speed), cell)", "y": "=top", "w": "=bw", "h": "=bh"
    },
    // a parallax layer: 640 wide, repeating every 320, moving `speed` units per shop
    "layer": {
      "type": "image", "src": "{art}/dusk/{name}.png", "fit": "pixel",
      "x": "=-mod(round(scroll * speed), 320)", "y": 0, "w": 640, "h": "=lh"
    }
  },

  "screens": {
    "all": { "top": [
      // the clock and the battery, each on a small panel over the sky
      { "type": "image", "src": "{art}/chip52.png", "fit": "pixel", "x": 4, "y": 4, "w": 52, "h": 14 },
      { "type": "text", "size": 12, "x": 4, "w": 52, "y": 5, "align": "center", "text": "{clock}", "color": "=paper" },
      { "type": "image", "src": "{art}/chip34.png", "fit": "pixel", "right": 4, "y": 4, "w": 34, "h": 14, "visible": "=battery >= 0" },
      { "type": "text", "size": 12, "right": 4, "w": 34, "y": 5, "align": "center", "text": "{battery}%",
        "color": "=battery < 20 ? '#ff6a6a' : paper", "visible": "=battery >= 0" },
      // starting a game, over everything (the status panels too): the picture breaks into growing blocks while the
      // brightness steps down in sixteenths, the Super NES's mosaic and fade
      { "type": "effect", "mosaic": "=view == 'launch' ? 1 + round(launch.progress * 15) : 0" },
      { "type": "rect", "fill": "=alpha('#000000', round(launch.progress * 15) / 15)", "visible": "=view == 'launch'" }
    ] },

    "home": {
      "top": [
        // the sky, then the town behind the street at three speeds
        { "type": "image", "src": "{art}/dusk/sky.png", "fit": "pixel", "x": 0, "y": 0, "w": 310, "h": 184 },
        { "use": "layer", "with": { "name": "clouds", "speed": 5, "lh": 110 } },
        { "use": "layer", "with": { "name": "far", "speed": 14, "lh": 184 } },
        { "use": "layer", "with": { "name": "mid", "speed": 36, "lh": 184 } },

        // the shops: each system one shopfront, 104 units apart, placed from the eased selection. Four fronts in three
        // awning colours, picked by the system's place on the shelf; its icon, name and game count are drawn on them.
        { "type": "list", "source": "systems", "direction": "free", "x": 0, "y": 0, "w": 310, "h": 184, "range": 3,
          "item": {
            "type": "group", "x": "=107 + round(pos * 104)", "y": 0, "w": 104, "h": 184,
            "children": [
              { "type": "image", "src": "{art}/dusk/shop{mod(i, 4)}{mod(i, 3)}.png", "fit": "pixel", "x": -8, "y": 12, "w": 112, "h": 170 },
              // the sign: gold on the selected shop, the name on up to two lines
              { "type": "image", "src": "{art}/dusk/signsel.png", "fit": "pixel", "x": 5, "y": "=pick(mod(i, 4), 74, 58, 82, 66)", "w": 86, "h": 24,
                "visible": "=sel" },
              { "type": "text", "size": 12, "x": 6, "w": 84, "y": "=pick(mod(i, 4), 75, 59, 83, 67)", "h": 22, "align": "center", "valign": "middle",
                "text": "{item.name}", "color": "=ink", "wrap": true, "maxLines": 2, "lineHeight": 10 },
              // the display window: the system's icon behind the glass, its game count on a tag
              { "type": "image", "src": "{item.icon}", "fit": "pixel", "x": 13, "y": 132, "w": 32, "h": 32, "visible": "=item.games > 0" },
              { "type": "image", "src": "{art}/dusk/shine.png", "fit": "pixel", "x": 9, "y": 128, "w": 40, "h": 41, "visible": "=item.games > 0" },
              { "type": "rect", "x": 24, "y": 157, "w": 27, "h": 12, "fill": "=paper", "border": 1, "borderColor": "=ink", "visible": "=item.games > 0" },
              { "type": "text", "size": 12, "x": 24, "w": 27, "y": 157, "align": "center", "text": "{item.games}", "color": "=ink", "visible": "=item.games > 0" },
              { "type": "image", "src": "fav.png", "fit": "pixel", "x": 10, "y": 130, "w": 8, "h": 8, "visible": "=item.fav" },
              // no games yet: the shutter is down
              { "type": "image", "src": "{art}/dusk/closed.png", "fit": "pixel", "x": 5, "y": 123, "w": 86, "h": 55, "visible": "=item.games == 0" },
              { "type": "rect", "x": 24, "y": 140, "w": 48, "h": 14, "fill": "=paper", "border": 1, "borderColor": "=ink", "visible": "=item.games == 0" },
              { "type": "text", "size": 12, "x": 24, "w": 48, "y": 141, "align": "center", "text": "Closed", "color": "=ink", "visible": "=item.games == 0" },
              // the lamp between this shop and the next
              { "type": "image", "src": "{art}/dusk/lamp.png", "fit": "pixel", "x": 88, "y": 66, "w": 24, "h": 112 },
              // a maker's first shop: the block's street sign, on a tall post between it and the shop before
              { "type": "rect", "x": -6, "y": 36, "w": 2, "h": 60, "fill": "=ink", "visible": "=item.newBlock && i > 0" },
              { "type": "group", "layout": "row", "padding": 3, "x": -5, "y": 24, "anchor": "top center", "h": 14,
                "fill": "=awnB", "border": 1, "borderColor": "=ink", "visible": "=item.newBlock && i > 0",
                "children": [ { "type": "text", "size": 12, "text": "{item.maker}", "color": "=paper", "shadow": { "x": 1, "y": 1, "color": "=ink" } } ] }
            ]
          } },

        // the road: a kerb, then four cobbled bands, faster toward the viewer, which fakes depth
        { "type": "rect", "x": 0, "y": 178, "w": 310, "h": 1, "fill": "=paper" },
        { "use": "band", "with": { "n": 0, "top": 179, "bh": 7, "cell": 14, "bw": 392, "speed": 104 } },
        { "use": "band", "with": { "n": 1, "top": 186, "bh": 10, "cell": 18, "bw": 396, "speed": 125 } },
        { "use": "band", "with": { "n": 2, "top": 196, "bh": 13, "cell": 24, "bw": 384, "speed": 150 } },
        { "use": "band", "with": { "n": 3, "top": 209, "bh": 17, "cell": 30, "bw": 390, "speed": 187 } },

        // the walker, in front of the selected shop's door, facing the way you last walked. While the street scrolls
        // he walks (frames 1-4, one stride a quarter of a shop, so a step is a step whatever the speed); standing, he
        // bobs a pixel twice a second (frame 5) unless Motion is off. Only the bob reads `time`, and behavior.fps 4
        // wakes the idle street for it (twice per step, so timer jitter never skips one); frames that match draw nothing.
        { "type": "image", "fit": "pixel", "x": 167, "y": 147, "w": 28, "h": 41,
          "src": "{art}/dusk/mascot-{dir < 0 ? 'l' : 'r'}{abs(scroll - cursor) > 0.02 ? 1 + mod(floor(abs(scroll) * 4), 4) : motion ? mod(floor(time / 500), 2) * 5 : 0}.png" },

        // what's selected, on a panel at the bottom
        { "type": "image", "src": "{art}/hud.png", "fit": "pixel", "x": 0, "y": 224, "w": 310, "h": 46 },
        { "type": "text", "x": 8, "y": 226, "w": 176, "text": "{sys.name}", "font": "banana-title", "size": 24, "color": "=gold",
          "gradient": { "stops": ["=goldTop", "=goldTop", "=goldHi", "=gold", "=gold", "=goldLo", "=goldDeep", "=goldDeep"] },
          "outline": { "width": 1, "color": "=hudLo" } },
        { "type": "text", "size": 12, "right": 8, "y": 228, "w": 120, "align": "right",
          "text": "=(sys.games == 0 ? 'Closed' : sys.games == 1 ? '1 game' : sys.games + ' games') + '  ' + (cursor + 1) + '/' + count",
          "color": "=paper", "shadow": { "x": 1, "y": 1, "color": "=hudLo" } },
        { "type": "text", "size": 12, "right": 8, "y": 240, "w": 124, "align": "right", "visible": "=sys.hasResume", "text": "Last: {sys.resumeTitle}",
          "color": "=paperLo", "shadow": { "x": 1, "y": 1, "color": "=hudLo" } },
        { "type": "list", "source": "hints", "direction": "row", "x": 8, "y": 254, "w": 294, "h": 13, "gap": 6, "flow": true, "scrollMode": "none",
          "justify": "between", "item": { "use": "pill" } }
      ]
    },

    "library": {
      "top": [
        // inside the shop: the wallpaper, the header, the counter, the receipt and the shelf's planks are one picture
        { "type": "image", "src": "{art}/interior.png", "fit": "pixel", "x": 0, "y": 0, "w": 310, "h": 270 },
        // between the clock and the battery (drawn over every view)
        { "type": "image", "src": "{sys.icon}", "fit": "pixel", "x": 60, "y": 3, "w": 16, "h": 16 },
        { "type": "text", "size": 12, "x": 80, "y": 5, "w": 146, "text": "{sys.name}", "color": "=gold", "shadow": { "x": 1, "y": 1, "color": "=hudLo" } },
        { "type": "text", "size": 12, "right": 42, "y": 5, "w": 40, "align": "right", "text": "{cursor + 1}/{count}", "color": "=paper" },

        // the box on the counter: the whole picture, whatever its shape (Game Boy boxes are square, Super NES ones
        // wide), on the box's dark backing
        { "type": "image", "src": "{game.art}", "fallback": "{sys.icon}", "fit": "contain", "x": 12, "y": 32, "w": 82, "h": 104 },
        { "type": "text", "size": 12, "x": 10, "w": 86, "y": 70, "align": "center", "text": "{empty.title}", "color": "=paper", "visible": "=empty", "wrap": true },

        // the receipt: what the shelf knows about the game
        { "type": "text", "size": 12, "x": 14, "y": 148, "text": "Receipt", "color": "=ink" },
        { "type": "text", "size": 12, "x": 14, "y": 166, "w": 78, "text": "{game.sub}", "color": "=dk", "wrap": true, "maxLines": 5 },

        // the shelf
        { "type": "list", "source": "games", "direction": "column", "x": 106, "y": 27, "w": 198, "h": 220, "itemH": 18, "gap": 2,
          "scrollMode": "edge", "clip": true,
          "item": { "type": "group", "w": 198, "h": 18, "children": [
            { "type": "image", "src": "{art}/row.png", "fit": "pixel", "x": 4, "y": 1, "w": 192, "h": 15, "visible": "=!sel" },
            { "type": "image", "src": "{art}/rowsel.png", "fit": "pixel", "x": 0, "y": 0, "w": 198, "h": 17, "visible": "=sel" },
            { "type": "rect", "x": "=sel ? 3 : 6", "y": 3, "w": 5, "h": 11, "fill": "=pick(mod(i, 3), awnA, awnB, awnC)", "border": 1, "borderColor": "=ink" },
            { "type": "text", "size": 12, "x": "=sel ? 12 : 15", "y": 3, "w": 176, "text": "{item.title}", "color": "=sel ? ink : paper" },
            { "type": "image", "src": "fav.png", "fit": "pixel", "right": 4, "y": 5, "w": 8, "h": 8, "visible": "=item.fav" }
          ] } },

        { "type": "list", "source": "hints", "direction": "row", "x": 8, "y": 254, "w": 294, "h": 13, "gap": 6, "flow": true, "scrollMode": "none",
          "justify": "between", "item": { "use": "pill" } }
      ]
    }
  }
}
