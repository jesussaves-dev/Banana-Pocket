From: Banana <bananalinux@proton.me>
Date: Thu, 05 Nov 2026 21:00:00 +0000
Subject: [PATCH] osd: the volume and brightness pills are the menu's own card

In a game, RetroArch's notification is its own flat grey bar in the bottom-left
corner: no icon, no segments, no relation to the pill Banana's menu draws for
the same two values. The daemon already owns the channel (SHOW_MSG into
/run/banana/retroarch.cmd), so this teaches the drawing side what a level line
looks like.

"BN V <0-100>" and "BN B <0-100>" are recognised in command_show_osd_msg() and
drawn as the menu's card: the same 310x42 box at the same place (top centre)
scaled from the menu's 640x557 canvas, the same 12x12 speaker/sun grids as
quads, ten segments and the gold percent. The card is one live widget updated in
place, not a queued message: a held key sends a line per repeat, and the queue
showed them one after another -- the pill trailing a second behind the press.
Every other message takes the untouched path, so a save state, a screenshot or a
core's own notice look exactly as before.

The card's fill and edge follow the menu: banana-ui writes
/data/banana/osd-style when it applies a theme, and this reads it once, falling
back to the dark card. Corners are square because the widget has no rounded
primitive; crisp themes, the five shipped ones, are square in the menu too.

The achievement card loses the English "Achievement Unlocked - N%" header
(the OS speaks three languages and the menu's toast never showed it) and its
subtitle takes the same gold. Badge, title and points stay.

Signed-off-by: Banana <bananalinux@proton.me>
---
 command.c                                  |  44 +++++++--
 gfx/gfx_widgets.c                          | 221 +++++++++++++++++++++++++++++
 gfx/gfx_widgets.h                          |   5 +
 gfx/widgets/gfx_widget_achievement_popup.c |  30 ++--
 4 files changed, 267 insertions(+), 33 deletions(-)

--- a/command.c
+++ b/command.c
@@ -737,8 +737,43 @@
    return true;
 }
 
+/* BananaOS: "BN V <0-100>" / "BN B <0-100>" are the daemon's volume and
+ * brightness pill lines. They last 1.5 s like the menu's own card; every other
+ * message keeps RetroArch's 3 s. */
+static bool command_banana_osd(const char *arg, int *sun, int *pct)
+{
+   const char *p;
+   int v = 0;
+   if (!arg || arg[0] != 'B' || arg[1] != 'N' || arg[2] != ' ')
+      return false;
+   if (arg[3] != 'V' && arg[3] != 'B')
+      return false;
+   if (arg[4] != ' ')
+      return false;
+   for (p = arg + 5; *p; p++)
+   {
+      if (*p < '0' || *p > '9' || v > 1000)
+         return false;
+      v = v * 10 + (*p - '0');
+   }
+   if (p == arg + 5 || v > 100)
+      return false;
+   *sun = (arg[3] == 'B');
+   *pct = v;
+   return true;
+}
+
 bool command_show_osd_msg(command_t *cmd, const char* arg)
 {
+    int sun = 0;
+    int pct = 0;
+    if (command_banana_osd(arg, &sun, &pct))
+    {
+       /* The level pill is a widget of its own, updated in place: pushing it through the message queue made a
+        * held key show a trail of stale cards a second behind the press. */
+       banana_osd_show(sun, pct);
+       return true;
+    }
     runloop_msg_queue_push(arg, strlen(arg), 1, 180, false, NULL,
           MESSAGE_QUEUE_ICON_DEFAULT, MESSAGE_QUEUE_CATEGORY_INFO);
     return true;
--- a/gfx/gfx_widgets.c
+++ b/gfx/gfx_widgets.c
@@ -1138,6 +1138,195 @@
    return width;
 }
 
+/* BananaOS: the menu's level card, drawn in the game.
+ * The daemon sends "BN V <0-100>" (volume) and "BN B <0-100>" (brightness);
+ * the menu publishes the card's colours to /data/banana/osd-style whenever it
+ * applies a theme. Everything else in the queue is untouched. */
+#define BANANA_OSD_CANVAS_H 557.0f /* shortcut: the menu's 640x557 canvas; a different panel needs this revisited */
+#define BANANA_OSD_BG       0x211f26
+#define BANANA_OSD_EDGE     0xf1ede2
+
+void banana_osd_style(unsigned *bg, unsigned *edge)
+{
+   static bool loaded = false;
+   static unsigned s_bg   = BANANA_OSD_BG;
+   static unsigned s_edge = BANANA_OSD_EDGE;
+   if (!loaded)
+   {
+      FILE *f = fopen("/data/banana/osd-style", "r");
+      loaded = true;
+      if (f)
+      {
+         char line[64];
+         unsigned v;
+         while (fgets(line, sizeof(line), f))
+         {
+            if (sscanf(line, "bg %6x", &v) == 1)
+               s_bg = v;
+            else if (sscanf(line, "edge %6x", &v) == 1)
+               s_edge = v;
+         }
+         fclose(f);
+      }
+   }
+   *bg   = s_bg;
+   *edge = s_edge;
+}
+
+void banana_osd_color(float *out, unsigned hex, float alpha)
+{
+   float r = (float)((hex >> 16) & 0xFF) / 255.0f;
+   float g = (float)((hex >>  8) & 0xFF) / 255.0f;
+   float b = (float)((hex >>  0) & 0xFF) / 255.0f;
+   out[0] = out[4] = out[8]  = out[12] = r;
+   out[1] = out[5] = out[9]  = out[13] = g;
+   out[2] = out[6] = out[10] = out[14] = b;
+   out[3] = out[7] = out[11] = out[15] = alpha;
+}
+
+static void banana_osd_quad(gfx_display_t *p_disp, void *userdata,
+      unsigned video_width, unsigned video_height,
+      float x, float y, float w, float h, float *color)
+{
+   if (w <= 0.0f || h <= 0.0f)
+      return;
+   gfx_display_draw_quad(p_disp, userdata, video_width, video_height,
+         x, y, w, h, video_width, video_height, color, NULL);
+}
+
+/* One live card, replaced in place: the daemon sends a line per key repeat, and a message queue would show them
+ * one after another -- the pill lagging a second behind the keys. */
+static int      banana_osd_kind  = -1;
+static int      banana_osd_pct   = 0;
+static unsigned banana_osd_until = 0;
+
+void banana_osd_show(int sun, int pct)
+{
+   dispgfx_widget_t *p_dispwidget = dispwidget_get_ptr();
+   banana_osd_kind  = sun;
+   banana_osd_pct   = pct;
+   banana_osd_until = p_dispwidget->gfx_widgets_frame_count + 90; /* 1.5 s at 60 Hz, the menu's own card */
+}
+
+static void banana_osd_draw(
+      dispgfx_widget_t *p_dispwidget,
+      gfx_display_t *p_disp,
+      int sun_kind,
+      int pct_value,
+      float alpha,
+      void *userdata,
+      unsigned video_width,
+      unsigned video_height)
+{
+   static const char *const VOL[12]  = { "............", ".....#......", "....##...#..", "...###....#.", "####.#..#..#", "#..#.#...#.#",
+      "#..#.#...#.#", "####.#..#..#", "...###....#.", "....##...#..", ".....#......", "............" };
+   static const char *const MUTE[12] = { "............", ".....#......", "....##......", "...###.#...#", "####.#..#.#.", "#..#.#...#..",
+      "#..#.#...#..", "####.#..#.#.", "...###.#...#", "....##......", ".....#......", "............" };
+   static const char *const SUN[12]  = { ".....##.....", ".#...##...#.", "..#......#..", "....####....", "...######...", "##.######.##",
+      "##.######.##", "...######...", "....####....", "..#......#..", ".#...##...#.", ".....##....." };
+   unsigned bg;
+   unsigned edge;
+   float    scale;
+   float    w;
+   float    h;
+   float    x0;
+   float    y0;
+   float    x1;
+   float    cy;
+   float    k;
+   float    b;
+   float    in;
+   float    card[16];
+   float    border[16];
+   float    lit[16];
+   float    unlit[16];
+   float    icon[16];
+   float    bx0;
+   float    bx1;
+   float    seg;
+   float    gap;
+   float    sy;
+   float    sh;
+   float    ix;
+   float    iy;
+   int      r;
+   int      c;
+   int      i;
+   int      pctw;
+   char     txt[8];
+   unsigned text_color;
+
+   banana_osd_style(&bg, &edge);
+   scale = (float)video_height / BANANA_OSD_CANVAS_H;
+   w     = 310.0f * scale;
+   h     = 42.0f  * scale;
+   x0    = ((float)video_width - w) * 0.5f;
+   y0    = 4.0f   * scale;
+   x1    = x0 + w;
+   cy    = y0 + h * 0.5f;
+   b     = (float)(int)(2.0f * scale + 0.5f);
+   in    = (float)(int)(14.0f * scale + 0.5f);
+   k     = (float)(int)(2.0f * scale + 0.5f);
+
+   if (b < 1.0f)
+      b = 1.0f;
+   if (k < 2.0f)
+      k = 2.0f;
+
+   banana_osd_color(border, edge, alpha);
+   banana_osd_color(card,   bg,   alpha);
+   banana_osd_color(lit,    0xffe68a, alpha);
+   banana_osd_color(unlit,  0x3a3540, alpha);
+   banana_osd_color(icon,   (!sun_kind && pct_value <= 0) ? 0xff8a96 : 0xf1ede2, alpha);
+
+   banana_osd_quad(p_disp, userdata, video_width, video_height, x0, y0, w, h, border);
+   banana_osd_quad(p_disp, userdata, video_width, video_height, x0 + b, y0 + b, w - 2.0f * b, h - 2.0f * b, card);
+
+   /* Icon: the menu's 12x12 grids, one quad per lit pixel */
+   {
+      const char *const *ic = sun_kind ? SUN : (pct_value <= 0 ? MUTE : VOL);
+      ix = x0 + in;
+      iy = cy - 6.0f * k;
+      for (r = 0; r < 12; r++)
+         for (c = 0; c < 12; c++)
+            if (ic[r][c] == '#')
+               banana_osd_quad(p_disp, userdata, video_width, video_height,
+                     ix + (float)c * k, iy + (float)r * k, k, k, icon);
+   }
+
+   /* Percent, right-aligned in the gold the menu uses */
+   snprintf(txt, sizeof(txt), "%d%%", pct_value);
+   pctw = font_driver_get_message_width(
+         p_dispwidget->gfx_widget_fonts.msg_queue.font, "100%", 4, 1.0f);
+   if (pctw < 0)
+      pctw = (int)(4.0f * p_dispwidget->gfx_widget_fonts.msg_queue.glyph_width);
+
+   /* Ten segments between the icon and the percent */
+   bx0 = x0 + in + 12.0f * k + 12.0f * scale;
+   bx1 = x1 - in - (float)pctw - 10.0f * scale;
+   seg = (bx1 - bx0) / 10.0f;
+   gap = (float)(int)(3.0f * scale + 0.5f);
+   if (gap < 2.0f)
+      gap = 2.0f;
+   sy  = cy - 8.0f * scale;
+   sh  = 16.0f * scale;
+   for (i = 0; i < 10; i++)
+      banana_osd_quad(p_disp, userdata, video_width, video_height,
+            (float)(int)(bx0 + (float)i * seg + 0.5f), sy,
+            (float)(int)(seg - gap + 0.5f), sh,
+            i < (pct_value + 5) / 10 ? lit : unlit);
+
+   text_color = COLOR_TEXT_ALPHA(0xffe68aff, (unsigned)(alpha * 255.0f));
+   gfx_widgets_draw_text(&p_dispwidget->gfx_widget_fonts.msg_queue,
+         txt,
+         x1 - in,
+         cy + p_dispwidget->gfx_widget_fonts.msg_queue.line_centre_offset,
+         video_width, video_height,
+         text_color,
+         TEXT_ALIGN_RIGHT,
+         true);
+}
+
 static void gfx_widgets_draw_task_msg(
       dispgfx_widget_t *p_dispwidget,
       gfx_display_t            *p_disp,
@@ -1848,6 +2037,21 @@
 #endif
    }
 
+   /* BananaOS: the level card, drawn in place so a held key updates it rather than queueing */
+   if (banana_osd_kind >= 0)
+   {
+      unsigned left = (banana_osd_until > p_dispwidget->gfx_widgets_frame_count)
+            ? banana_osd_until - p_dispwidget->gfx_widgets_frame_count : 0;
+      if (left)
+      {
+         float banana_alpha = (left < 15) ? (float)left / 15.0f : 1.0f;
+         banana_osd_draw(p_dispwidget, p_disp, banana_osd_kind, banana_osd_pct,
+               banana_alpha, userdata, video_width, video_height);
+      }
+      else
+         banana_osd_kind = -1;
+   }
+
    /* Ensure all text is flushed */
    gfx_widgets_flush_text(video_width, video_height,
          &p_dispwidget->gfx_widget_fonts.regular);
--- a/gfx/gfx_widgets.h
+++ b/gfx/gfx_widgets.h
@@ -420,6 +420,11 @@
 
 bool gfx_widgets_ready(void);
 
+/* BananaOS: the menu's level card, published at /data/banana/osd-style */
+void banana_osd_style(unsigned *bg, unsigned *edge);
+void banana_osd_show(int sun, int pct);
+void banana_osd_color(float *out, unsigned hex, float alpha);
+
 dispgfx_widget_t *dispwidget_get_ptr(void);
 
 extern const gfx_widget_t gfx_widget_screenshot;
--- a/gfx/widgets/gfx_widget_achievement_popup.c
+++ b/gfx/widgets/gfx_widget_achievement_popup.c
@@ -300,34 +300,29 @@
       }
 
       /* Backdrop */
-      gfx_display_draw_quad(
-         p_disp,
-         video_info->userdata,
-         video_width,
-         video_height,
-         screen_pos_x + state->height,
-         screen_pos_y,
-         state->width,
-         state->height,
-         video_width,
-         video_height,
-         p_dispwidget->backdrop_orig,
-         NULL);
+      {
+         unsigned banana_bg;
+         unsigned banana_edge;
+         float    banana_card[16];
+         banana_osd_style(&banana_bg, &banana_edge);
+         banana_osd_color(banana_card, banana_bg, DEFAULT_BACKDROP);
+         gfx_display_draw_quad(
+            p_disp,
+            video_info->userdata,
+            video_width,
+            video_height,
+            screen_pos_x + state->height,
+            screen_pos_y,
+            state->width,
+            state->height,
+            video_width,
+            video_height,
+            banana_card,
+            NULL);
+      }
 
-      /* Title */
-      gfx_widgets_draw_text(
-         &p_dispwidget->gfx_widget_fonts.regular,
-         state->queue[state->queue_read_index].title,
-         screen_pos_x + state->height - text_unfold_offset
-         + p_dispwidget->simple_widget_padding,
-         screen_pos_y
-         + p_dispwidget->gfx_widget_fonts.regular.line_height
-         + p_dispwidget->gfx_widget_fonts.regular.line_ascender,
-         video_width,
-         video_height,
-         TEXT_COLOR_FAINT,
-         TEXT_ALIGN_LEFT,
-         true);
+      /* Title: the menu never shows an English "Achievement Unlocked" line,
+       * so the card is the badge, the achievement's name and its points. */
 
       /* Subtitle */
 
@@ -342,7 +337,7 @@
          - p_dispwidget->gfx_widget_fonts.regular.line_descender,
          video_width,
          video_height,
-         TEXT_COLOR_INFO,
+         0xffe68aff,
          TEXT_ALIGN_LEFT,
          true);
 
