From: Banana <bananalinux@proton.me>
Date: Fri, 20 Nov 2026 12:00:00 +0000
Subject: [PATCH] cheevos: dump the whole achievement set for the game page

The menu's game page lists a game's achievements, locked and won, and RetroArch
is the only process that has them. This writes the full core set to
BANANA_RA_CHEEVOS_SET (default /run/banana/cheevos-set) as the game loads and
at each unlock: one tab-separated line per achievement -- id, unlocked, points,
rarity, title, description, badge path. It goes to a temporary file and is
renamed into place, so a reader never sees half a set. Like the rest of 0013,
a failure writes nothing and the emulator carries on.
---
--- a/cheevos/cheevos.c
+++ b/cheevos/cheevos.c
@@ -351,6 +351,76 @@
    fclose(f);
 }
 
+/* the whole set, for the game page: one line per achievement, tab-separated:
+ *   id <TAB> unlocked (0/1) <TAB> points <TAB> rarity <TAB> title <TAB> description <TAB> badge
+ * where badge is the full path of the unlocked badge PNG (the locked picture is the same name with "_lock" before the
+ * ".png"). Written to a temporary file and renamed, so the menu never reads half a set. Called as the game loads and at
+ * each unlock, which is when the unlocked column changes. */
+#define BANANA_CHEEVOS_SET_FILE "/run/banana/cheevos-set"
+
+static void banana_cheevos_set(void)
+{
+   settings_t* settings = config_get_ptr();
+   rc_client_achievement_list_t* list;
+   const char* path;
+   char tmp[PATH_MAX_LENGTH];
+   char title[256], description[512], badge[PATH_MAX_LENGTH];
+   uint32_t b, i;
+   FILE* f;
+   bool hardcore;
+
+   if (!rcheevos_locals.client || !settings)
+      return;
+
+   path = banana_cheevos_path("BANANA_RA_CHEEVOS_SET", BANANA_CHEEVOS_SET_FILE);
+   if (snprintf(tmp, sizeof(tmp), "%s.tmp", path) >= (int)sizeof(tmp))
+      return;
+
+   list = rc_client_create_achievement_list(rcheevos_locals.client,
+         RC_CLIENT_ACHIEVEMENT_CATEGORY_CORE,
+         RC_CLIENT_ACHIEVEMENT_LIST_GROUPING_LOCK_STATE);
+   if (!list)
+      return;
+
+   if (!(f = fopen(tmp, "w")))
+   {
+      rc_client_destroy_achievement_list(list);
+      return;
+   }
+
+   hardcore = rc_client_get_hardcore_enabled(rcheevos_locals.client);
+   for (b = 0; b < list->num_buckets; b++)
+   {
+      const rc_client_achievement_bucket_t* bucket = &list->buckets[b];
+
+      /* the unsupported ones can't be won here, so they are not part of the set the game page counts */
+      if (bucket->bucket_type == RC_CLIENT_ACHIEVEMENT_BUCKET_UNSUPPORTED)
+         continue;
+
+      for (i = 0; i < bucket->num_achievements; i++)
+      {
+         const rc_client_achievement_t* a = bucket->achievements[i];
+
+         banana_cheevos_clean(title, sizeof(title), a->title);
+         banana_cheevos_clean(description, sizeof(description), a->description);
+         badge[0] = '\0';
+         if (!string_is_empty(settings->paths.directory_thumbnails)
+               && !string_is_empty(a->badge_name))
+            snprintf(badge, sizeof(badge), "%s/cheevos/badges/%s.png",
+                  settings->paths.directory_thumbnails, a->badge_name);
+
+         fprintf(f, "%u\t%d\t%u\t%.2f\t%s\t%s\t%s\n",
+               (unsigned)a->id, a->unlocked ? 1 : 0, (unsigned)a->points,
+               hardcore ? (double)a->rarity_hardcore : (double)a->rarity,
+               title, description, badge);
+      }
+   }
+   rc_client_destroy_achievement_list(list);
+
+   if (fclose(f) != 0 || rename(tmp, path) != 0)
+      remove(tmp);
+}
+
 /* one unlock: the progress above, then the line the menu's toast is built from */
 static void banana_cheevos_awarded(const rc_client_achievement_t* cheevo)
 {
@@ -363,6 +433,7 @@
       return;
 
    banana_cheevos_progress();
+   banana_cheevos_set();
 
    rc_client_get_user_game_summary(rcheevos_locals.client, &summary);
 
@@ -1528,6 +1599,7 @@
    rcheevos_show_game_placard();
    /* Banana: the game's progress as it starts, so the menu's card is right for a play that unlocks nothing */
    banana_cheevos_progress();
+   banana_cheevos_set();
 
 #if HAVE_REWIND
    if (!rcheevos_hardcore_active())
