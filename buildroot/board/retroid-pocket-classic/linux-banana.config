# Banana's own kernel config for the Retroid Pocket Classic (SM4450 Rev Q), K1.2.
#
# Buildroot loads this file as a defconfig (`make buildroot_defconfig`, then the board fragments, then olddefconfig):
# every symbol not named here takes its Kconfig default, the same as `make savedefconfig` assumes. So a line here is a
# change from the default: `=y`/`=m` for a driver this board binds or a script uses, `# ... is not set` for a default
# this handheld has no use for. Kconfig defaults that are kept on purpose (CPU errata workarounds, PAC/BTI, SVE,
# stack protector, seccomp) are not listed; see docs/KERNEL-CONFIG.md §5.
# Each entry says which bound driver, script or menu needs it; "dep of X" means it is only here because X needs it.
# Check (docs/KERNEL-CONFIG.md §5): defconfig + fragments + olddefconfig must keep every line here, and the
# savedefconfig of the result must contain nothing that is not in this file or a fragment.

# ---- Platform and boot ----
# Namespaces: on by default without EXPERT ("default !EXPERT"); EXPERT below would otherwise turn them off.
CONFIG_NAMESPACES=y
# Qualcomm SM4450 platform. Without it every qcom driver below is invisible, not just off.
CONFIG_ARCH_QCOM=y
# OpenABL (arm-efi) loads this kernel through its EFI stub.
CONFIG_EFI=y
CONFIG_EFI_STUB=y
# Only to reach the VT prompt so linux-banana.fragment can turn VTs off; every other option keeps its default.
CONFIG_EXPERT=y
# The shipped kernel is preemptible for the menu's frame times (7.2.0 banner: PREEMPT_DYNAMIC).
CONFIG_PREEMPT_DYNAMIC=y
# Full preemption, as the shipped kernel had: the choice's default is PREEMPT_LAZY, which made PipeWire's 10 ms
# cycle late enough that game and menu sound came out slow and crunchy.
CONFIG_PREEMPT=y
# High-resolution timers and an idle tickless kernel, as the shipped one had. Both are off without a line here:
# timers then round up to the 4 ms tick (PipeWire's timerfd, RetroArch's frame pacing, SDL's delays), and a periodic
# tick wakes every idle core 250 times a second.
CONFIG_HIGH_RES_TIMERS=y
CONFIG_NO_HZ_IDLE=y

# ---- Kernel core (userspace: rcS, bananad, dropbear, PipeWire) ----
# Every =m below, and modprobe itself.
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
# The handheld runs real users; /dev node ownership and the shell's uids.
CONFIG_MULTIUSER=y
# shm and memfd: PipeWire's and Wayland's buffers.
CONFIG_SHMEM=y
# epoll/poll loop in banana-ui and bananad.
CONFIG_EPOLL=y
# bananad waits on signalfd for sleep/shutdown; timerfd for its 60 s poll.
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
# eventfd: PipeWire's wakeups.
CONFIG_EVENTFD=y
CONFIG_MEMFD_CREATE=y
# bananad's inotify watches (battery, jack, settings.conf).
CONFIG_INOTIFY_USER=y
# Every binary on the image, and rcS itself.
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
# /proc/config.gz: what tools/kernel-report.sh reads (K0).
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
# The serial console rcS and the boot log use (qcom GENI UART).
CONFIG_TTY=y
CONFIG_UNIX98_PTYS=y
CONFIG_SUSPEND=y
CONFIG_PM_SLEEP=y
# ADSP/WPSS firmware, ath10k's board files.
CONFIG_FW_LOADER=y
# debugfs: pstore/suspend debugging and qcom_stats below.
CONFIG_DEBUG_FS=y
CONFIG_CPU_IDLE=y

# ---- Filesystems (root, /boot, /data) ----
# dep of SQUASHFS: a menuconfig allnoconfig turns off, which hides every filesystem under it.
CONFIG_MISC_FILESYSTEMS=y
# rcS:5-17 mounts /proc, /sys, /dev.
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
# The root filesystem (p2/p3, rootfstype=squashfs, LZ4).
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_LZ4=y
# /boot is FAT (p1, rcS:67).
CONFIG_VFAT_FS=y
# /data is exFAT (p4, rcS:53); rcS:59 falls back to whatever can mount.
CONFIG_EXFAT_FS=y
CONFIG_NLS=y
# vfat's defaults (FAT_DEFAULT_CODEPAGE=437, FAT_DEFAULT_IOCHARSET=iso8859-1): rcS:67 and sd2 pass no codepage=,
# and without these two the /boot mount fails, so updates and Previous version can't write extlinux.conf.
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y

# ---- Network: Wi-Fi (WCN3950), USB NCM, ssh ----
CONFIG_NET=y
# Wayland and PipeWire sockets, dropbear.
CONFIG_UNIX=y
CONFIG_INET=y
# udhcpd/udhcpc's raw sockets on the USB NCM link.
CONFIG_PACKET=y
# dep of WLAN/NETDEVICES: the network device core.
CONFIG_NET_CORE=y
CONFIG_NETDEVICES=y
CONFIG_WLAN=y
# rfkill: Wi-Fi on/off from Settings.
CONFIG_RFKILL=y
# ath10k's cfg80211/mac80211 stack, as in the baseline (built in, not modules).
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_ATH10K=y
# The Wi-Fi device itself; rcS:126 loads it in the background.
CONFIG_ATH10K_SNOC=m

# ---- Display (the menu's first frame) ----
CONFIG_DRM=y
CONFIG_DRM_KMS_HELPER=y
# msm-mdss/dpu/dsi/dsi_phy and adreno in one; the panel.
CONFIG_DRM_MSM=y
# adreno's devfreq ("Couldn't initialize GPU devfreq" without it: no /sys/class/devfreq, the GPU at a fixed clock).
# banana-perf sets the governor per profile: powersave (menu), simple_ondemand (powersave/balanced), performance.
# DEVFREQ_THERMAL lets the GPU be a cooling device, like the CPUs.
CONFIG_PM_DEVFREQ=y
CONFIG_DEVFREQ_GOV_SIMPLE_ONDEMAND=y
CONFIG_DEVFREQ_GOV_PERFORMANCE=y
CONFIG_DEVFREQ_GOV_POWERSAVE=y
CONFIG_DEVFREQ_THERMAL=y
CONFIG_DRM_PANEL_CHIPWEALTH_CH13726A=y
# Display and GPU clock controllers (dispcc-sm4450, gpucc-sm4450).
CONFIG_SM_DISPCC_4450=y
CONFIG_SM_GPUCC_4450=y
# arm-smmu x2: the display and GPU iommus.
CONFIG_ARM_SMMU=y
# dep of DRM_MSM, and of the USB-C DP altmode chain below.
CONFIG_IOMMU_SUPPORT=y
CONFIG_DRM_BRIDGE=y
# Backlight class: the panel's brightness control.
CONFIG_BACKLIGHT_CLASS_DEVICE=y

# ---- Input: the pad MCU, touch, volume, power ----
CONFIG_INPUT=y
# dep of the input drivers below (each is a menuconfig allnoconfig turns off).
CONFIG_INPUT_KEYBOARD=y
CONFIG_INPUT_MISC=y
CONFIG_INPUT_JOYSTICK=y
CONFIG_INPUT_TOUCHSCREEN=y
# evdev is how banana-ui and RetroArch read the pad; uinput is RetroArch's virtual pad.
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_UINPUT=y
# serial/rsinput, the pad MCU on a GENI UART (ROCKNIX patch).
CONFIG_JOYSTICK_RSINPUT=y
CONFIG_JOYSTICK_BANANA_PAD=y
# platform/banana: board identity sysfs (model, board, board id, kernel version).
CONFIG_BANANA_PLATFORM=y
CONFIG_BANANA_POCKET=y
# i2c/edt_ft5x06: the FT5452 touch panel.
CONFIG_TOUCHSCREEN_EDT_FT5X06=y
# gpio-keys: volume.
CONFIG_KEYBOARD_GPIO=y
# pm8941-pwrkey x2: power and resin.
CONFIG_INPUT_PM8941_PWRKEY=y
# pm8xxx-vib: the rumble pulse bananad starts (bananad.c:1897).
CONFIG_INPUT_PM8XXX_VIBRATOR=m

# ---- USB host: pads, keyboards, drives by MODALIAS (bananad.c:2025) ----
# dep of every USB driver below.
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
# The dwc3 controller's host side.
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_HID_SUPPORT=y
# HID core and the generic driver built in, so a keyboard or mouse works with no module load.
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
# The HID pad drivers, built in: their aliases are hid:, and bananad's load_driver (bananad.c:2021) only modprobes
# usb: aliases, so as modules nothing would load them and the pad would fall back to hid-generic's mapping.
CONFIG_HID_SONY=y
CONFIG_HID_PLAYSTATION=y
CONFIG_HID_NINTENDO=y
CONFIG_HID_LOGITECH=y
CONFIG_HID_MICROSOFT=y
# dep of HID_PLAYSTATION/HID_NINTENDO (lightbar and player LEDs).
CONFIG_LEDS_CLASS_MULTICOLOR=y
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
# xpad matches usb: aliases, so bananad loads it by MODALIAS.
CONFIG_JOYSTICK_XPAD=m
CONFIG_JOYSTICK_XPAD_FF=y
# A USB stick or card reader, and a serial adapter: usb: aliases, loaded by bananad.
CONFIG_USB_STORAGE=m
CONFIG_USB_ACM=m
CONFIG_USB_SERIAL=m
# dep of USB_STORAGE (SCSI disk behind it).
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y

# ---- Storage: the microSD holds the whole OS ----
CONFIG_BLOCK=y
CONFIG_MMC=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
# sdhci_msm and mmcblk: the microSD.
CONFIG_MMC_SDHCI_MSM=y
CONFIG_MMC_BLOCK=y

# ---- USB gadget: NCM link, adb (FunctionFS), the disk ----
# configfs-gadget.banana (AGENTS.md §8; usb-gadget script).
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_F_FS=y
# mass_storage.0: the disk usb-msc exports (usb-gadget:102).
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
# dwc3-qcom in either role: an OTG pad takes the port as host.
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_COMBO=y
CONFIG_PHY_QCOM_USB_SNPS_FEMTO_V2=y

# ---- SoC core: clocks, power, buses ----
CONFIG_COMMON_CLK=y
CONFIG_COMMON_CLK_QCOM=y
# gcc-sm4450.
CONFIG_SM_GCC_4450=y
CONFIG_QCOM_CLK_RPMH=y
CONFIG_PINCTRL=y
# sm4450-tlmm.
CONFIG_PINCTRL_SM4450=y
CONFIG_PINCTRL_LPASS_LPI=y
CONFIG_PINCTRL_SM8450_LPASS_LPI=y
# qcom-spmi-gpio x3.
CONFIG_PINCTRL_QCOM_SPMI_PMIC=y
CONFIG_INTERCONNECT=y
# dep of INTERCONNECT_QCOM_SM4450 and _BCM_VOTER.
CONFIG_INTERCONNECT_QCOM=y
# qnoc-sm4450 x9.
CONFIG_INTERCONNECT_QCOM_SM4450=y
CONFIG_INTERCONNECT_QCOM_BCM_VOTER=y
# rpmh, cmd-db, qcom-rpmhpd.
CONFIG_QCOM_RPMH=y
CONFIG_QCOM_COMMAND_DB=y
CONFIG_QCOM_RPMHPD=y
# qcom-rpmh-regulator x2, reg-fixed-voltage x8.
CONFIG_REGULATOR_QCOM_RPMH=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
# qcom_scm, qcom-smem, hwspinlock (dep of QCOM_SMEM), smp2p x2, ipcc, aoss_qmp, pdc.
CONFIG_QCOM_SCM=y
CONFIG_QCOM_SMEM=y
CONFIG_HWSPINLOCK=y
CONFIG_HWSPINLOCK_QCOM=y
CONFIG_QCOM_SMP2P=y
CONFIG_QCOM_IPCC=y
CONFIG_QCOM_AOSS_QMP=y
CONFIG_QCOM_PDC=y
# qcom-socinfo, qcom_stats, qfprom.
CONFIG_QCOM_SOCINFO=y
CONFIG_QCOM_STATS=y
CONFIG_NVMEM=y
CONFIG_NVMEM_QCOM_QFPROM=y
# geni_se_qup x2, geni_i2c x2, qcom_geni_serial x3, gpi (dep of the GENI buses).
CONFIG_QCOM_GENI_SE=y
CONFIG_I2C_QCOM_GENI=y
CONFIG_SERIAL_QCOM_GENI=y
CONFIG_SERIAL_QCOM_GENI_CONSOLE=y
# dep of JOYSTICK_RSINPUT: the pad MCU is a serdev client on a GENI UART.
CONFIG_SERIAL_DEV_BUS=y
CONFIG_DMADEVICES=y
CONFIG_QCOM_GPI_DMA=y
# dep of the remoteproc stack below, and of QCOM_PMIC_GLINK.
CONFIG_MAILBOX=y
CONFIG_REMOTEPROC=y
# qcom-cpufreq-hw (banana-perf writes schedutil/performance), psci-cpuidle-domain, genpd x25.
CONFIG_ARM_QCOM_CPUFREQ_HW=y
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_ARM_PSCI_CPUIDLE=y
CONFIG_ARM_PSCI_CPUIDLE_DOMAIN=y
# arch-timer-mmio, armv8-pmu.
CONFIG_ARM_ARCH_TIMER=y
# qcom-tsens x2 (rpc-thermals.sh), qcom-spmi-adc5 x2, spmi-temp-alarm, hwmon for pwm-fan.
CONFIG_THERMAL=y
# The board dts's thermal zones throttle cpu0-7 through cooling-maps; without a cpufreq cooling device those maps
# bind nothing and the only cooling device is ath10k's, so a hot SoC is never slowed down (the shipped kernel had it).
CONFIG_CPU_THERMAL=y
CONFIG_CPU_FREQ_THERMAL=y
CONFIG_HWMON=y
CONFIG_IIO=y
CONFIG_GPIOLIB=y
CONFIG_REGMAP=y

# ---- PMIC, battery, USB-C ----
# spmi_pmic_arb, pmic-spmi x4.
CONFIG_SPMI=y
CONFIG_SPMI_MSM_PMIC_ARB=y
CONFIG_MFD_SPMI_PMIC=y
CONFIG_QCOM_SPMI_ADC5=y
CONFIG_QCOM_TSENS=y
CONFIG_QCOM_SPMI_TEMP_ALARM=y
# qcom,spmi-sdam x10.
CONFIG_NVMEM_SPMI_SDAM=y
# rtc-pm8xxx, qcom-pon (power key and reset).
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_PM8XXX=y
CONFIG_POWER_RESET_QCOM_PON=y
# qcom_pmic_glink (+ rpmsg), pmic_glink_altmode, pmic_glink_ucsi.
CONFIG_QCOM_PMIC_GLINK=y
CONFIG_UCSI_PMIC_GLINK=y
CONFIG_TYPEC=y
CONFIG_TYPEC_UCSI=y
# qcom-pdm-mapper x2, the battery manager (auxiliary/qcom_battmgr), rpmsg transports it rides on.
CONFIG_QCOM_PD_MAPPER=y
CONFIG_RPMSG_QCOM_SMD=y
CONFIG_RPMSG_QCOM_GLINK_SMEM=y
CONFIG_RPMSG_CHAR=y
CONFIG_POWER_SEQUENCING=y
CONFIG_POWER_SUPPLY=y
CONFIG_BATTERY_QCOM_BATTMGR=m
CONFIG_EXTCON=y
# qcom_smd_qrtr x2, rpmsg_ctrl x2, rpmsg/qcom,apr.
CONFIG_QRTR=y
CONFIG_QRTR_SMD=y
CONFIG_RPMSG_CTRL=y
CONFIG_QCOM_APR=y

# ---- Audio: rcS:78-95 loads this stack in a fixed order ----
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_TIMER=y
CONFIG_SND_PCM=y
CONFIG_SND_SOC=y
# ADSP remoteproc: qcom_q6v5_pas x2 and its deps (rcS:78), loaded before anything audio.
CONFIG_QCOM_Q6V5_PAS=m
CONFIG_QCOM_Q6V5_COMMON=m
CONFIG_QCOM_SYSMON=m
CONFIG_QCOM_PIL_INFO=m
CONFIG_QCOM_RPROC_COMMON=m
# AudioReach: aprbus/qcom-apm, q6apm-dai, q6apm-lpass-dais, q6prm-lpass-clock (rcS:88).
CONFIG_SND_SOC_QCOM=m
CONFIG_SND_SOC_QDSP6=m
CONFIG_SND_SOC_QDSP6_APM=m
CONFIG_SND_SOC_QDSP6_APM_DAI=m
CONFIG_SND_SOC_QDSP6_APM_LPASS_DAI=m
CONFIG_SND_SOC_QDSP6_PRM=m
CONFIG_SND_SOC_QDSP6_PRM_LPASS_CLOCKS=m
# LPASS macros rx/tx/va (rcS:90).
CONFIG_SND_SOC_LPASS_MACRO_COMMON=m
CONFIG_SND_SOC_LPASS_RX_MACRO=m
CONFIG_SND_SOC_LPASS_TX_MACRO=m
CONFIG_SND_SOC_LPASS_VA_MACRO=m
# SoundWire and the RX macro's iface clock (rcS:90).
CONFIG_SOUNDWIRE=m
CONFIG_SOUNDWIRE_QCOM=m
CONFIG_REGMAP_SOUNDWIRE=m
CONFIG_SLIMBUS=m
# wcd937x codec, its SoundWire wrapper, mbhc, classh (rcS:92).
CONFIG_SND_SOC_WCD937X=m
CONFIG_SND_SOC_WCD937X_SDW=m
CONFIG_SND_SOC_WCD_MBHC=m
CONFIG_SND_SOC_WCD_CLASSH=m
# The machine driver: card appears at 5.44 s (rcS:94-95).
CONFIG_SND_SOC_SC8280XP=m
CONFIG_SND_SOC_QCOM_COMMON=m
CONFIG_SND_SOC_QCOM_SDW=m
# aw88166 x2: the speaker amps (ROCKNIX patch), bound by the DT, so built in.
CONFIG_SND_SOC_AW88166=y

# ---- Wi-Fi power sequencing, fan, file sharing, pstore ----
# pwrseq-qcom_wcn.
CONFIG_POWER_SEQUENCING_QCOM_WCN=y
# pwm_fan (rcS:105). The PM6450 PWM is the LPG driver's pm6450-pwm entry (K4.3); built in so it is there before pwm_fan.
CONFIG_PWM=y
CONFIG_LEDS_QCOM_LPG=y
CONFIG_SENSORS_PWM_FAN=m
# ksmbd, loaded by Settings > File sharing (share:10).
CONFIG_SMB_SERVER=m
# ramoops: the panic log K8 wants saved.
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y

# ---- Kconfig defaults this handheld turns off ----
# No PS/2 or serial mouse can attach; a USB mouse is HID.
# CONFIG_INPUT_MOUSE is not set
# BSD ptys and TIOCSTI: nothing uses them, and TIOCSTI is a known injection path.
# CONFIG_LEGACY_PTYS is not set
# CONFIG_LEGACY_TIOCSTI is not set
# /dev/mem and /dev/port: no Banana script reads physical memory.
# CONFIG_DEVMEM is not set
# No swap partition or zram on the image.
# CONFIG_SWAP is not set
# The microSD runs mq-deadline; BFQ and Kyber are unused schedulers.
# CONFIG_IOSCHED_BFQ is not set
# CONFIG_MQ_IOSCHED_KYBER is not set
# hwrng modules nothing loads; the CRNG seeds from SMCCC TRNG through the arch hook without them.
# CONFIG_HW_RANDOM is not set
# Heap randomization on (COMPAT_BRK=y turns it off for 20-year-old libc5 binaries).
# CONFIG_COMPAT_BRK is not set
# v7.3 made these three "default m if ARCH_QCOM". An =m dep caps DRM_MSM (LLCC, OCMEM) and LEDS_QCOM_LPG (PBS) at =m,
# and no node in the dts uses any of them. Off keeps the 7.2 result (the display and PWM drivers built in).
# CONFIG_QCOM_PBS is not set
# CONFIG_QCOM_LLCC is not set
# CONFIG_QCOM_OCMEM is not set
