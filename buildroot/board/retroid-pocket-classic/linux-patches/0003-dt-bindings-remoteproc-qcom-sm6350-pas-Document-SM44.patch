From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tom <tom@localhost>
Date: Tue, 17 Nov 2026 18:36:25 -0500
Subject: [PATCH] dt-bindings: remoteproc: qcom,sm6350-pas: Document SM4450
 ADSP and WPSS

The SM4450 ADSP and WPSS PAS use the same resources as the SM6350 ADSP
and CDSP: an XO clock, five interrupts, and LCX/LMX respectively CX/MX
power domains. Extend the existing binding instead of adding a
near-identical one.

Signed-off-by: tom <tom@localhost>
---
 .../bindings/remoteproc/qcom,sm6350-pas.yaml           | 10 ++++++++--
 1 file changed, 8 insertions(+), 2 deletions(-)

diff --git a/Documentation/devicetree/bindings/remoteproc/qcom,sm6350-pas.yaml b/Documentation/devicetree/bindings/remoteproc/qcom,sm6350-pas.yaml
index 42e02c64347a0dc0246e13ee02ab0324be028055..a751bed5fd6babe6390db96e3ba7f99a20694c30 100644
--- a/Documentation/devicetree/bindings/remoteproc/qcom,sm6350-pas.yaml
+++ b/Documentation/devicetree/bindings/remoteproc/qcom,sm6350-pas.yaml
@@ -4,18 +4,20 @@
 $id: http://devicetree.org/schemas/remoteproc/qcom,sm6350-pas.yaml#
 $schema: http://devicetree.org/meta-schemas/core.yaml#
 
-title: Qualcomm SM6350 Peripheral Authentication Service
+title: Qualcomm SM6350/SM4450 Peripheral Authentication Service
 
 maintainers:
   - Manivannan Sadhasivam <manivannan.sadhasivam@linaro.org>
 
 description:
-  Qualcomm SM6350 SoC Peripheral Authentication Service loads and boots
+  Qualcomm SM6350 and SM4450 SoC Peripheral Authentication Service loads and boots
   firmware on the Qualcomm DSP Hexagon cores.
 
 properties:
   compatible:
     enum:
+      - qcom,sm4450-adsp-pas
+      - qcom,sm4450-wpss-pas
       - qcom,sm6350-adsp-pas
       - qcom,sm6350-cdsp-pas
       - qcom,sm6350-mpss-pas
@@ -84,6 +86,8 @@ allOf:
       properties:
         compatible:
           enum:
+            - qcom,sm4450-adsp-pas
+            - qcom,sm4450-wpss-pas
             - qcom,sm6350-adsp-pas
             - qcom,sm6350-cdsp-pas
     then:
@@ -103,6 +107,7 @@ allOf:
       properties:
         compatible:
           enum:
+            - qcom,sm4450-adsp-pas
             - qcom,sm6350-adsp-pas
     then:
       properties:
@@ -119,6 +124,7 @@ allOf:
       properties:
         compatible:
           enum:
+            - qcom,sm4450-wpss-pas
             - qcom,sm6350-cdsp-pas
     then:
       properties:
