From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: sunshineinabox <aqemail@gmail.com>
Date: Tue, 27 Oct 2026 15:21:41 -0400
Subject: [PATCH] soc: qcom: pd-mapper: add SM4450 domains

K5 audit: send upstream (K6): not in mainline v7.3; no binding needed (qcom,sm4450 is in v7.3 qcom.yaml), so the easiest first review.
---
 drivers/soc/qcom/qcom_pd_mapper.c | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/drivers/soc/qcom/qcom_pd_mapper.c b/drivers/soc/qcom/qcom_pd_mapper.c
index 0dc1a7946050c6d63c4a756bff5613605ab7099b..72aeb361631773bc90240c71061f5fed4b6ce45e 100644
--- a/drivers/soc/qcom/qcom_pd_mapper.c
+++ b/drivers/soc/qcom/qcom_pd_mapper.c
@@ -502,6 +502,15 @@ static const struct qcom_pdm_domain_data *sdm845_domains[] = {
 	NULL,
 };
 
+static const struct qcom_pdm_domain_data *sm4450_domains[] = {
+	&adsp_audio_pd,
+	&adsp_root_pd,
+	&adsp_charger_pd,
+	&adsp_sensor_pd,
+	&mpss_root_pd_gps,
+	NULL,
+};
+
 static const struct qcom_pdm_domain_data *sm6115_domains[] = {
 	&adsp_audio_pd,
 	&adsp_root_pd,
@@ -613,6 +622,7 @@ static const struct of_device_id qcom_pdm_domains[] __maybe_unused = {
 	{ .compatible = "qcom,sdm670", .data = sdm670_domains, },
 	{ .compatible = "qcom,sdm845", .data = sdm845_domains, },
 	{ .compatible = "qcom,sm4250", .data = sm6115_domains, },
+	{ .compatible = "qcom,sm4450", .data = sm4450_domains, },
 	{ .compatible = "qcom,sm6115", .data = sm6115_domains, },
 	{ .compatible = "qcom,sm6350", .data = sm6350_domains, },
 	{ .compatible = "qcom,sm7150", .data = sm7150_domains, },
