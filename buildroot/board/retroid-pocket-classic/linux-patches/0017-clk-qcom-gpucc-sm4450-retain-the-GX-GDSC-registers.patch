Subject: [PATCH] clk: qcom: gpucc-sm4450: retain the GX GDSC registers

K5 audit: send upstream (K6): not in mainline v7.3; verify on hardware first.
---
 drivers/clk/qcom/gpucc-sm4450.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/drivers/clk/qcom/gpucc-sm4450.c b/drivers/clk/qcom/gpucc-sm4450.c
index d3f1c6bf7dc0143fd6d0fa325b9ef2da0e10bd27..2b07aee1fb4dd1fdce22190ab1a09f239a30dcae 100644
--- a/drivers/clk/qcom/gpucc-sm4450.c
+++ b/drivers/clk/qcom/gpucc-sm4450.c
@@ -702,7 +702,7 @@ static struct gdsc gpu_cc_gx_gdsc = {
 		.name = "gpu_gx_gdsc",
 	},
 	.pwrsts = PWRSTS_OFF_ON,
-	.flags = CLAMP_IO | AON_RESET | SW_RESET | POLL_CFG_GDSCR,
+	.flags = CLAMP_IO | AON_RESET | SW_RESET | POLL_CFG_GDSCR | RETAIN_FF_ENABLE,
 };
 
 static struct clk_regmap *gpu_cc_sm4450_clocks[] = {
