From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tom <tom@localhost>
Date: Tue, 17 Nov 2026 18:36:25 -0500
Subject: [PATCH] dt-bindings: iommu: arm,smmu: Document SM4450 SMMU

Add the SM4450 apps SMMU (qcom,smmu-500, no clocks) and the SM4450 GPU
SMMU (qcom,adreno-smmu, which takes the same six clocks as the SM8450
one: gmu, hub, hlos, bus, iface and ahb).

Signed-off-by: tom <tom@localhost>
---
 Documentation/devicetree/bindings/iommu/arm,smmu.yaml | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/Documentation/devicetree/bindings/iommu/arm,smmu.yaml b/Documentation/devicetree/bindings/iommu/arm,smmu.yaml
index ffa33b7f4a9651628e44b1803185d88fa5381fe8..52ac57483ae350e6145b8fffe58759ada94dce43 100644
--- a/Documentation/devicetree/bindings/iommu/arm,smmu.yaml
+++ b/Documentation/devicetree/bindings/iommu/arm,smmu.yaml
@@ -60,6 +60,7 @@ properties:
               - qcom,sdx65-smmu-500
               - qcom,sdx75-smmu-500
               - qcom,shikra-smmu-500
+              - qcom,sm4450-smmu-500
               - qcom,sm6115-smmu-500
               - qcom,sm6125-smmu-500
               - qcom,sm6350-smmu-500
@@ -112,6 +113,7 @@ properties:
               - qcom,sc8180x-smmu-500
               - qcom,sc8280xp-smmu-500
               - qcom,shikra-smmu-500
+              - qcom,sm4450-smmu-500
               - qcom,sm6115-smmu-500
               - qcom,sm6125-smmu-500
               - qcom,sm8150-smmu-500
@@ -515,7 +517,9 @@ allOf:
       properties:
         compatible:
           items:
-            - const: qcom,sm8450-smmu-500
+            - enum:
+                - qcom,sm4450-smmu-500
+                - qcom,sm8450-smmu-500
             - const: qcom,adreno-smmu
             - const: qcom,smmu-500
             - const: arm,mmu-500
@@ -635,6 +639,7 @@ allOf:
                 - qcom,qcs8300-smmu-500
                 - qcom,sa8775p-smmu-500
                 - qcom,shikra-smmu-500
+                - qcom,sm4450-smmu-500
                 - qcom,sm6115-smmu-500
                 - qcom,sm6125-smmu-500
                 - qcom,sm8150-smmu-500
