From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tom <tom@localhost>
Date: Tue, 17 Nov 2026 13:53:48 -0500
Subject: [PATCH] leds: qcom-lpg: add PM6450 PWM

K5 audit: send upstream (K6): not in mainline v7.3; binding in this patch; fold the PM6450 clock-clamp patch into it first.

One PWM-only channel at 0xe800 (no LUT, no triled), taken from the stock
Android DT (qcom,pwms@e800 under qcom,pm6450@1). Lets the RPC fan's
pwm-fan bind.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 Documentation/devicetree/bindings/leds/leds-qcom-lpg.yaml | 2 ++
 drivers/leds/rgb/leds-qcom-lpg.c                          | 8 ++++++++
 2 files changed, 10 insertions(+)

diff --git a/Documentation/devicetree/bindings/leds/leds-qcom-lpg.yaml b/Documentation/devicetree/bindings/leds/leds-qcom-lpg.yaml
index 3da0fe532e7485e890c3174a5bc7148a63b500bc..a6f204da87c5669d61d55e98c7524da22512e81e 100644
--- a/Documentation/devicetree/bindings/leds/leds-qcom-lpg.yaml
+++ b/Documentation/devicetree/bindings/leds/leds-qcom-lpg.yaml
@@ -23,6 +23,7 @@ properties:
   compatible:
     oneOf:
       - enum:
+          - qcom,pm6450-pwm
           - qcom,pm660l-lpg
           - qcom,pm8150b-lpg
           - qcom,pm8150l-lpg
@@ -150,6 +151,7 @@ allOf:
         compatible:
           contains:
             enum:
+              - qcom,pm6450-pwm
               - qcom,pm660l-lpg
               - qcom,pm8150b-lpg
               - qcom,pm8150l-lpg
diff --git a/drivers/leds/rgb/leds-qcom-lpg.c b/drivers/leds/rgb/leds-qcom-lpg.c
index d7d6518de30f2b3e32945829f7fbc5e798a3203b..eb0255f0d00e4ebd39b4e7d0202986cd9b7fa600 100644
--- a/drivers/leds/rgb/leds-qcom-lpg.c
+++ b/drivers/leds/rgb/leds-qcom-lpg.c
@@ -1811,6 +1811,13 @@ static const struct lpg_data pm8350c_pwm_data = {
 	},
 };
 
+static const struct lpg_data pm6450_pwm_data = {
+	.num_channels = 1,
+	.channels = (const struct lpg_channel_data[]) {
+		{ .base = 0xe800 },
+	},
+};
+
 static const struct lpg_data pmk8550_pwm_data = {
 	.num_channels = 2,
 	.channels = (const struct lpg_channel_data[]) {
@@ -1820,6 +1827,7 @@ static const struct lpg_data pmk8550_pwm_data = {
 };
 
 static const struct of_device_id lpg_of_table[] = {
+	{ .compatible = "qcom,pm6450-pwm", .data = &pm6450_pwm_data },
 	{ .compatible = "qcom,pm660l-lpg", .data = &pm660l_lpg_data },
 	{ .compatible = "qcom,pm8150b-lpg", .data = &pm8150b_lpg_data },
 	{ .compatible = "qcom,pm8150l-lpg", .data = &pm8150l_lpg_data },
