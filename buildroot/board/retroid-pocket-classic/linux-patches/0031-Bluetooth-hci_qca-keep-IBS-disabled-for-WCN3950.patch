From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tom <jesussaves-ai@users.noreply.github.com>
Date: Tue, 27 Oct 2026 15:21:41 -0400
Subject: [PATCH] Bluetooth: hci_qca: keep IBS disabled for WCN3950

K5 audit: send upstream (K6) only with a justification for WCN3950 IBS/suspend behaviour; otherwise keep downstream.
---
 drivers/bluetooth/hci_qca.c | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/drivers/bluetooth/hci_qca.c b/drivers/bluetooth/hci_qca.c
index e22e2269efd78f74d099bf4573e554a4a9cc62c6..871aa0f41c9a5f38ea78d67d3c721dc220a6596b 100644
--- a/drivers/bluetooth/hci_qca.c
+++ b/drivers/bluetooth/hci_qca.c
@@ -2032,7 +2032,8 @@ static int qca_setup(struct hci_uart *hu)
 	ret = qca_uart_setup(hdev, qca_baudrate, soc_type, ver,
 			firmware_name, rampatch_name);
 	if (!ret) {
-		clear_bit(QCA_IBS_DISABLED, &qca->flags);
+		if (soc_type != QCA_WCN3950)
+			clear_bit(QCA_IBS_DISABLED, &qca->flags);
 		qca_debugfs_init(hdev);
 		hu->hdev->hw_error = qca_hw_error;
 		hu->hdev->reset = qca_reset;
@@ -2672,6 +2673,9 @@ static int __maybe_unused qca_suspend(struct device *dev)
 	if (test_bit(QCA_ROM_FW, &qca->flags))
 		return 0;
 
+	if (qca_soc_type(hu) == QCA_WCN3950)
+		return 0;
+
 	/* During SSR after memory dump collection, controller will be
 	 * powered off and then powered on.If controller is powered off
 	 * during SSR then we should wait until SSR is completed.
