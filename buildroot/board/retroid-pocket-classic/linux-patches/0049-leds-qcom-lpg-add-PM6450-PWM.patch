From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Thomas Mulkey <thomasmulkey1997@gmail.com>
Date: Tue, 17 Nov 2026 13:53:48 -0500
Subject: [PATCH] leds: qcom-lpg: add PM6450 PWM

One PWM-only channel at 0xe800 (no LUT, no triled), taken from the stock
Android DT (qcom,pwms@e800 under qcom,pm6450@1). Lets the RPC fan's
pwm-fan bind.

Assisted-by: Claude:claude-sonnet-5-5
Signed-off-by: Thomas Mulkey <thomasmulkey1997@gmail.com>
---
 .../devicetree/bindings/leds/leds-qcom-lpg.yaml     |  2 ++
 drivers/leds/rgb/leds-qcom-lpg.c                    | 13 +++++++++++++
 2 files changed, 15 insertions(+)

diff --git a/Documentation/devicetree/bindings/leds/leds-qcom-lpg.yaml b/Documentation/devicetree/bindings/leds/leds-qcom-lpg.yaml
index 3da0fe532e7485e890c3174a5bc7148a63b500bc..a6f204da87c5669d61d55e98c7524da22512e81e 100644
--- a/Documentation/devicetree/bindings/leds/leds-qcom-lpg.yaml
+++ b/Documentation/devicetree/bindings/leds/leds-qcom-lpg.yaml
@@ -23,6 +23,7 @@ properties:
   compatible:
     oneOf:
       - enum:
+          - qcom,pm6450-pwm
           - qcom,pm660l-lpg
           - qcom,pm8150b-lpg
           - qcom,pm8150l-lpg
@@ -150,6 +151,7 @@ allOf:
         compatible:
           contains:
             enum:
+              - qcom,pm6450-pwm
               - qcom,pm660l-lpg
               - qcom,pm8150b-lpg
               - qcom,pm8150l-lpg
diff --git a/drivers/leds/rgb/leds-qcom-lpg.c b/drivers/leds/rgb/leds-qcom-lpg.c
index d7d6518de30f2b3e32945829f7fbc5e798a3203b..07b83647d357a3db2d5a46b59863bc558ccff301 100644
--- a/drivers/leds/rgb/leds-qcom-lpg.c
+++ b/drivers/leds/rgb/leds-qcom-lpg.c
@@ -243,6 +243,7 @@ struct lpg_data {
 	unsigned int triled_base;
 	bool triled_has_atc_ctl;
 	bool triled_has_src_sel;
+	unsigned int hi_res_clk_count;	/* usable hi-res clock sources, 0 = all */
 	int num_channels;
 	const struct lpg_channel_data *channels;
 };
@@ -452,6 +453,8 @@ static int lpg_calc_freq(struct lpg_channel *chan, uint64_t period)
 	if (chan->subtype == LPG_SUBTYPE_HI_RES_PWM) {
 		clk_rate_arr = lpg_clk_rates_hi_res;
 		clk_len = ARRAY_SIZE(lpg_clk_rates_hi_res);
+		if (chan->lpg->data->hi_res_clk_count)
+			clk_len = chan->lpg->data->hi_res_clk_count;
 		pwm_resolution_arr = lpg_pwm_resolution_hi_res;
 		pwm_resolution_count = ARRAY_SIZE(lpg_pwm_resolution_hi_res);
 		max_res = LPG_RESOLUTION_15BIT;
@@ -1811,6 +1814,15 @@ static const struct lpg_data pm8350c_pwm_data = {
 	},
 };
 
+static const struct lpg_data pm6450_pwm_data = {
+	/* no 76.8 MHz source: the downstream driver stops at 19.2 MHz and the channel is dead on it */
+	.hi_res_clk_count = 4,
+	.num_channels = 1,
+	.channels = (const struct lpg_channel_data[]) {
+		{ .base = 0xe800 },
+	},
+};
+
 static const struct lpg_data pmk8550_pwm_data = {
 	.num_channels = 2,
 	.channels = (const struct lpg_channel_data[]) {
@@ -1820,6 +1832,7 @@ static const struct lpg_data pmk8550_pwm_data = {
 };
 
 static const struct of_device_id lpg_of_table[] = {
+	{ .compatible = "qcom,pm6450-pwm", .data = &pm6450_pwm_data },
 	{ .compatible = "qcom,pm660l-lpg", .data = &pm660l_lpg_data },
 	{ .compatible = "qcom,pm8150b-lpg", .data = &pm8150b_lpg_data },
 	{ .compatible = "qcom,pm8150l-lpg", .data = &pm8150l_lpg_data },
