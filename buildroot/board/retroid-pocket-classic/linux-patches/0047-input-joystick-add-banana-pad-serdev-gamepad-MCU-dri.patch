From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Thomas Mulkey <thomasmulkey1997@gmail.com>
Date: Tue, 17 Nov 2026 11:20:55 -0500
Subject: [PATCH] input: joystick: add banana-pad serdev gamepad MCU driver

Clean-room driver for the UART gamepad MCU, written from
docs/BANANA-PAD-PROTOCOL.md. Matches "banana,pad" so rsinput stays
selectable. Proper stream framing, per-device button state, watchdog
recovery as documented.

Assisted-by: Claude:claude-sonnet-5-5
Signed-off-by: Thomas Mulkey <thomasmulkey1997@gmail.com>
---
 drivers/input/joystick/Kconfig      |  11 +
 drivers/input/joystick/Makefile     |   1 +
 drivers/input/joystick/banana-pad.c | 563 ++++++++++++++++++++++++++++
 3 files changed, 575 insertions(+)
 create mode 100644 drivers/input/joystick/banana-pad.c

diff --git a/drivers/input/joystick/Kconfig b/drivers/input/joystick/Kconfig
index 0da3c0f44ecfcac2d4fd6bcc3d5b02143cb7abe4..0e34bd73434a2a76ade707202fb94737a8f3b954 100644
--- a/drivers/input/joystick/Kconfig
+++ b/drivers/input/joystick/Kconfig
@@ -387,6 +387,17 @@ config JOYSTICK_RSINPUT
 	tristate "UART Based gamepad driver that found in AYN and Retroid Pocket products"
 	depends on SERIAL_DEV_BUS
 
+config JOYSTICK_BANANA_PAD
+	tristate "Banana pad UART gamepad MCU (clean-room driver)"
+	depends on SERIAL_DEV_BUS
+	help
+	  Driver for the serial gamepad MCU found in AYN and Retroid Pocket
+	  handhelds, matched by the "banana,pad" devicetree compatible. It
+	  can coexist with JOYSTICK_RSINPUT; the devicetree picks one.
+
+	  To compile this driver as a module, choose M here: the
+	  module will be called banana-pad.
+
 config JOYSTICK_FSIA6B
 	tristate "FlySky FS-iA6B RC Receiver"
 	select SERIO
