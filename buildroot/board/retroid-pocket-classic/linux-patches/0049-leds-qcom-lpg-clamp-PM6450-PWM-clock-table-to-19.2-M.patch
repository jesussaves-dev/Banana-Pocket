From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tom <tom@localhost>
Date: Tue, 17 Nov 2026 14:40:32 -0500
Subject: [PATCH] leds: qcom-lpg: clamp PM6450 PWM clock table to 19.2 MHz

K5 audit: send upstream (K6): fold into "leds: qcom-lpg: add PM6450 PWM".

Stock pwm-qti-lpg has no 76.8 MHz entry; selecting it left the fan not spinning.
Add hi_res_clk_count to lpg_data and clamp clk_len in lpg_calc_freq.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 drivers/leds/rgb/leds-qcom-lpg.c | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/drivers/leds/rgb/leds-qcom-lpg.c b/drivers/leds/rgb/leds-qcom-lpg.c
index eb0255f0d00e4ebd39b4e7d0202986cd9b7fa600..07b83647d357a3db2d5a46b59863bc558ccff301 100644
--- a/drivers/leds/rgb/leds-qcom-lpg.c
+++ b/drivers/leds/rgb/leds-qcom-lpg.c
@@ -243,6 +243,7 @@ struct lpg_data {
 	unsigned int triled_base;
 	bool triled_has_atc_ctl;
 	bool triled_has_src_sel;
+	unsigned int hi_res_clk_count;	/* usable hi-res clock sources, 0 = all */
 	int num_channels;
 	const struct lpg_channel_data *channels;
 };
@@ -452,6 +453,8 @@ static int lpg_calc_freq(struct lpg_channel *chan, uint64_t period)
 	if (chan->subtype == LPG_SUBTYPE_HI_RES_PWM) {
 		clk_rate_arr = lpg_clk_rates_hi_res;
 		clk_len = ARRAY_SIZE(lpg_clk_rates_hi_res);
+		if (chan->lpg->data->hi_res_clk_count)
+			clk_len = chan->lpg->data->hi_res_clk_count;
 		pwm_resolution_arr = lpg_pwm_resolution_hi_res;
 		pwm_resolution_count = ARRAY_SIZE(lpg_pwm_resolution_hi_res);
 		max_res = LPG_RESOLUTION_15BIT;
@@ -1812,6 +1815,8 @@ static const struct lpg_data pm8350c_pwm_data = {
 };
 
 static const struct lpg_data pm6450_pwm_data = {
+	/* no 76.8 MHz source: the downstream driver stops at 19.2 MHz and the channel is dead on it */
+	.hi_res_clk_count = 4,
 	.num_channels = 1,
 	.channels = (const struct lpg_channel_data[]) {
 		{ .base = 0xe800 },
