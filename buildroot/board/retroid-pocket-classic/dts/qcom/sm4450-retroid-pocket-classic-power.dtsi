 *
 * Retroid Pocket Classic (SM4450 "parrot"): power.
 * Maintained by Banana as its own description of this handheld (it started as ROCKNIX's tree).
 *
 * PMIC regulators, the battery and charger (through pmic_glink to the ADSP), the PMICs on SPMI
 * with their ADC channels and RTC, and CPU frequency scaling.
 *
 * Included from sm4450-retroid-pocket-classic-common.dtsi; do not include it on its own.
 */

/* ---- Battery, charger and USB-C role, reported by the ADSP over pmic_glink ---- */

/ {
	pmic_glink: pmic-glink {
		compatible = "qcom,sm4450-pmic-glink", "qcom,pmic-glink";
		#address-cells = <1>;
		#size-cells = <0>;
		orientation-gpios = <&tlmm 94 GPIO_ACTIVE_HIGH>;
		status = "okay";

		connector@0 {
			compatible = "usb-c-connector";
			reg = <0>;
			power-role = "dual";
			data-role = "dual";

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;

					pmic_glink_hs_in: endpoint {
						remote-endpoint = <&usb_1_dwc3_hs>;
					};
				};

				port@1 {
					reg = <1>;

					pmic_glink_ss_in: endpoint {
						remote-endpoint = <&usb_1_qmpphy_out>;
					};
				};
			};
		};
	};

	vph_pwr: regulator-vph-pwr {
		compatible = "regulator-fixed";
		regulator-name = "vph_pwr";
		regulator-min-microvolt = <3700000>;
		regulator-max-microvolt = <3700000>;
		regulator-always-on;
		regulator-boot-on;
	};
};

/* ---- RPMh regulators (PM6450 "b", PM7250B "e") ---- */

