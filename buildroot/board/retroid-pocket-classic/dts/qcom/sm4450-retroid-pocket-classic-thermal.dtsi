 *
 * Retroid Pocket Classic (SM4450 "parrot"): thermal.
 * Maintained by Banana as its own description of this handheld (it started as ROCKNIX's tree).
 *
 * The two TSENS controllers and the thermal zones on them: trip points, CPU and GPU cooling.
 * The fan's curve on the CPU and GPU zones is per board revision, in the .dts files.
 *
 * Included from sm4450-retroid-pocket-classic-common.dtsi; do not include it on its own.
 */

&soc {
	tsens0: thermal-sensor@c263000 {
		compatible = "qcom,sm4450-tsens", "qcom,tsens-v2";
		reg = <0x0 0x0c263000 0x0 0x1ff>,
		      <0x0 0x0c222000 0x0 0x8>;
		#qcom,sensors = <16>;
		interrupts = <GIC_SPI 506 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 508 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "uplow", "critical";
		#thermal-sensor-cells = <1>;
	};

	tsens1: thermal-sensor@c265000 {
		compatible = "qcom,sm4450-tsens", "qcom,tsens-v2";
		reg = <0x0 0x0c265000 0x0 0x1ff>,
		      <0x0 0x0c223000 0x0 0x8>;
		#qcom,sensors = <6>;
		interrupts = <GIC_SPI 507 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 509 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "uplow", "critical";
		#thermal-sensor-cells = <1>;
	};
};

/ {
	thermal-zones {
		aoss0-thermal {
			thermal-sensors = <&tsens0 0>;

			trips {
				aoss0_alert: trip-point0 {
					temperature = <95000>;
					hysteresis = <2000>;
					type = "passive";
				};

				aoss0-crit {
					temperature = <115000>;
					hysteresis = <0>;
					type = "critical";
				};
			};
		};

		cpu0-thermal {
			thermal-sensors = <&tsens0 1>;

			trips {
				cpu0_alert: trip-point0 {
					temperature = <95000>;
					hysteresis = <2000>;
					type = "passive";
				};

				cpu0-crit {
					temperature = <115000>;
					hysteresis = <0>;
					type = "critical";
				};
			};

			cooling-maps {
				map0 {
					trip = <&cpu0_alert>;
					cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};

		cpu1-thermal {
			thermal-sensors = <&tsens0 2>;

			trips {
				cpu1_alert: trip-point0 {
